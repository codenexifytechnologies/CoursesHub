@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Error";
}

<div class="rbt-breadcrumb-default ptb--100 ptb_md--50 ptb_sm--30 bg-gradient-1">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb-inner text-center">
                    <h2>Oops! Something went wrong.</h2>
                    <p>Sorry, an unexpected error occurred. Please try again later.</p>
                    <ul class="page-list">
                        <li class="rbt-breadcrumb-item"><a href="@Url.Action("Index","Index", new { area="" })">Home</a></li>
                        <li>
                            <div class="icon-right"><i class="feather-chevron-right"></i></div>
                        </li>
                        <li class="rbt-breadcrumb-item active">Error</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="@CoursesHub.AssetVersion.Url("~/assets/js/main.js")"></script>
}



