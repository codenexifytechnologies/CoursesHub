    <script>
        $(document).ready(function () {
            $("#IndexsearchBox").on("keyup", function () {
                var query = $(this).val().trim();

                if (query.length >= 3) {
                    $.ajax({
                        url: '@Url.Action("SearchResults", "Index")',
                        type: 'GET',
                        data: { keyword: query },
                        success: function (data) {
                            $("#resultDivout").slideDown();
                            if (data && data.trim() !== "") {

                                $("#resultDiv").html(data);
                            } else {
                                $("#resultDiv").html("<p style='padding:10px;'>No results found.</p>").slideDown();
                            }
                        },
                        error: function () {
                            $("#resultDivout").slideDown();
                            $("#resultDiv").html("<p style='padding:10px;color:red;'>Something went wrong.</p>").slideDown();
                        }
                    });
                } else {
                    $("#resultDivout").fadeOut(100);
                }
            });

            $(document).on("click", function (e) {
                if (!$(e.target).closest("#IndexsearchBox, #resultDivout").length) {
                    $("#resultDivout").fadeOut(100);
                }
            });

            $(document).on("click", ".search-item", function () {
                $("#IndexsearchBox").val($(this).text());
                $("#resultDivout").fadeOut(100);
            });

            localStorage.setItem("EmailId", "@EmailId");
            localStorage.setItem("Password", "@Password");
            localStorage.setItem("LoginType", "@LoginType");

            setInterval(function () {
                $.ajax({
                    url: '/Index/SetSessionValues',
                    type: 'Post',
                    data: {
                        EmailId: localStorage.getItem("EmailId"),
                        Password: localStorage.getItem("Password"),
                        LoginType: localStorage.getItem("LoginType")
                    },
                    success: function (response) {
                        console.log('Repeated AJAX success:', response);
                    },
                    error: function (error) {
                        console.log('Error:', error);
                    }
                });
            }, 60000);
        });
    </script>
    <script>
        function showLoaderIfValid(form) {
            // Check HTML5 validation
            if (!form.checkValidity()) {
                return false; // STOP loader & STOP submit
            }
            // The branded loader covers the page (also stops double clicks); see assets/js/ch-loader.js
            if (window.CHLoader) { CHLoader.show("Loading…"); }
            return true; // Continue submit
        }
    </script>
    <script>
        function showLoaderIfValidReg(form) {
            var $form = $(form);

            if (!$form.valid()) {
                return false;
            }
            if (window.CHLoader) { CHLoader.show("Loading…"); }
            return true;
        }
    </script>
    <script>
        // Mobile menu: works on every page (some pages do not load main.js)
        (function () {
            var menu = document.querySelector('.popup-mobile-menu');
            if (!menu) return;
            var setOpen = function (isOpen) {
                menu.classList.toggle('active', isOpen);
                document.body.classList.toggle('fd-lock', isOpen);
                document.querySelectorAll('.hamberger-button').forEach(function (b) { b.setAttribute('aria-expanded', isOpen ? 'true' : 'false'); });
                if (isOpen) { var c = menu.querySelector('.close-button'); if (c) c.focus(); }
            };
            document.querySelectorAll('.hamberger-button').forEach(function (b) {
                b.setAttribute('aria-controls', 'mobile-menu');
                b.setAttribute('aria-expanded', 'false');
                b.setAttribute('aria-label', 'Open menu');
                b.addEventListener('click', function (e) { e.preventDefault(); setOpen(true); });
            });
            menu.querySelectorAll('.close-button').forEach(function (b) {
                b.addEventListener('click', function () { setOpen(false); });
            });
            // tap on the dark area outside the panel closes it
            menu.addEventListener('click', function (e) { if (e.target === menu) setOpen(false); });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && menu.classList.contains('active')) setOpen(false);
            });
        })();
    </script>
    <script>
        // Right-side "Find Your Course" filter drawer
        (function () {
            var drawer = document.getElementById('filter-drawer');
            var overlay = document.getElementById('filter-drawer-overlay');
            if (!drawer || !overlay) return;
            var openers = document.querySelectorAll('.js-filter-drawer-open');
            var lastOpener = null;

            function setOpen(isOpen) {
                drawer.classList.toggle('is-open', isOpen);
                drawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
                overlay.hidden = !isOpen;
                document.body.classList.toggle('fd-lock', isOpen);
                openers.forEach(function (b) { b.setAttribute('aria-expanded', isOpen ? 'true' : 'false'); });
                if (isOpen) {
                    drawer.querySelector('.fd-close').focus();
                } else if (lastOpener) {
                    lastOpener.focus();
                }
            }

            openers.forEach(function (btn) {
                btn.addEventListener('click', function (e) { e.preventDefault(); lastOpener = btn; setOpen(true); });
            });
            drawer.querySelector('.fd-close').addEventListener('click', function () { setOpen(false); });
            overlay.addEventListener('click', function () { setOpen(false); });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && drawer.classList.contains('is-open')) { setOpen(false); }
            });

            // One section open at a time
            drawer.querySelectorAll('.fd-group-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var willOpen = btn.getAttribute('aria-expanded') !== 'true';
                    drawer.querySelectorAll('.fd-group-btn').forEach(function (other) {
                        other.setAttribute('aria-expanded', 'false');
                        document.getElementById(other.getAttribute('aria-controls')).hidden = true;
                    });
                    btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
                    document.getElementById(btn.getAttribute('aria-controls')).hidden = !willOpen;
                });
            });
        })();
    </script>
</body>
</html>
