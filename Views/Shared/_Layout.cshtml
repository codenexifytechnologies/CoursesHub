        /* Mobile menu (.popup-mobile-menu) uses the template styles + brand-theme.css */

        .menu-divider {
            font-size: 11px;
            text-transform: uppercase;
            color: var(--accent-color);
            font-weight: 700;
            margin: 25px 0 10px 15px;
            letter-spacing: 1px;
            opacity: 0.8;
        }


        /* Main Links */
        .menu-link {
            color: #fff;
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 14px 15px;
            border-radius: 10px;
            font-weight: 500;
            transition: 0.3s;
            gap: 15px;
        }

            .menu-link i {
                font-size: 18px;
                color: var(--accent-color);
            }

            .menu-link:hover {
                background: rgba(255, 255, 255, 0.1);
                color: var(--accent-color) !important;
            }


        /* Accordion Styles */
        .accordion-item {
            margin-bottom: 8px;
        }

        .accordion-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 15px;
            background: rgba(255, 255, 255, 0.05); /* Transparent subtle highlight instead of white */
            border-radius: 10px;
            cursor: pointer;
            transition: 0.3s;
            color: #ffffff; /* Explicitly set text to white */
        }

            .accordion-header span {
                display: flex;
                align-items: center;
                gap: 15px;
                font-weight: 500;
                color: #ffffff; /* Force white text */
            }

            /* Change color on hover for better UX */
            .accordion-header:hover {
                background: rgba(255, 255, 255, 0.1);
                color: var(--accent-color); /* Turns brand orange on hover */
            }

            .accordion-header span i {
                color: var(--accent-color);
                font-size: 18px;
            }

            .accordion-header:hover {
                background: rgba(255, 255, 255, 0.1);
                color: var(--accent-color); /* Turns brand orange on hover */
            }



        /* Submenu Grid Styling */
        .accordion-content {
            display: none;
            padding: 15px;
            background: var(--secondary-dark);
            margin-top: 5px;
            border-radius: 10px;
            border: 1px solid rgba(var(--accent-rgb), 0.25);
        }

        .submenu-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

            .submenu-grid-2 a {
                color: #ffffff !important; /* Force white text */
                text-decoration: none;
                font-size: 13px;
                padding: 12px 5px;
                background: rgba(255, 255, 255, 0.1); /* Slight highlight */
                border-radius: 6px;
                text-align: center;
                transition: 0.2s;
                display: block;
                border: 1px solid rgba(255, 255, 255, 0.1);
            }

                .submenu-grid-2 a:hover {
                    background: var(--accent-color);
                    color: var(--on-accent-color) !important;
                    font-weight: 600;
                }


        /* Arrow rotation */
        .arrow {
            transition: 0.3s;
            opacity: 0.6;
        }

        .rotate {
            transform: rotate(180deg);
            opacity: 1;
            color: var(--accent-color);
        }


        /* Special Login Button */
        .login-special {
            background: var(--accent-color);
            color: var(--on-accent-color) !important;
            margin-top: 20px;
            justify-content: center;
        }

