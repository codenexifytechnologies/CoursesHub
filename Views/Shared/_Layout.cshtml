@using System.Configuration
@{
    string LoginName = string.Empty; string ProfileImage = string.Empty;
    string EmailId = string.Empty; string UserId = string.Empty; string Password = string.Empty;
    string LoginType = string.Empty;
    if (Session["Registration"] != null)
    {
        LoginType = ((CoursesHub.Models.Registration)Session["Registration"]).LoginType;

        if (LoginType == "Student")
        {
            CoursesHub.Models.StudentRegistration obj = ((CoursesHub.Models.Registration)Session["Registration"]).objStudentRegistration;

            LoginName = obj.FirstName + " " + obj.LastName;
            ProfileImage = System.Configuration.ConfigurationManager.AppSettings["BaseURL"].ToString() + "Uploads/NoImage.jpg";
            EmailId = obj.EmailId;
            Password = obj.Password;
            UserId = obj.Id.ToString();
        }
        else
        {
            CoursesHub.Models.UniversityRegistration obj = ((CoursesHub.Models.Registration)Session["Registration"]).objUniversityRegistration;

            LoginName = obj.Legal_Name_Organisation;
            ProfileImage = obj.Logo;
            EmailId = obj.Email;
            Password = obj.Password;
            UserId = obj.Id.ToString();
        }
    }
    CoursesHub.Models.Master _Master = (CoursesHub.Models.Master)ViewBag.GetMaster;

}
