@* Site footer, shared by the public, Student and Training Provider layouts *@
@{
    // Every page except the home page gets a line between the page content and the footer
    var isHomePage = string.Equals(ViewContext.RouteData.Values["controller"] as string, "Index", StringComparison.OrdinalIgnoreCase)
                     && string.Equals(ViewContext.RouteData.Values["action"] as string, "Index", StringComparison.OrdinalIgnoreCase)
                     && string.IsNullOrEmpty(ViewContext.RouteData.DataTokens["area"] as string);
}
@if (!isHomePage)
{
    <div class="ch-footer-divider" aria-hidden="true">
        <div class="container"><span></span></div>
    </div>
}

<footer class="rbt-footer footer-style-3 bg-color-white overflow-hidden">
    <div class="footer-top">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4 col-md-6 col-sm-6 col-12">
                    <div>
                        <div class="logo logo-dark">
                            <a href="@Url.Action("Index","Index", new { area = "" })">
                                <img src="~/assets/images/logo/logo.png" alt="Edu-cause">
                            </a>
                        </div>
                        <div class="logo d-none logo-light">
                            <a href="@Url.Action("Index","Index", new { area = "" })">
                                <img src="~/assets/images/dark/logo/logo-light.png" alt="Edu-cause">
                            </a>
                        </div>
                        <p class="description mt--20">
                            We’re always in search for talented
                            and motivated people. Don’t be shy introduce yourself!
                        </p>
                        <ul class="social-icon social-default justify-content-start">
                            <li>
                                <a href="https://www.facebook.com/courseshub.aus/">
                                    <i class="feather-facebook"></i>
                                </a>
                            </li>
                            <li>
                                <a href="https://www.youtube.com/%40CoursesHub-aus" target="_blank">
                                    <i class="feather-youtube"></i>
                                </a>
                            </li>
                            <li>
                                <a href="https://www.instagram.com/courseshubaus/">
                                    <i class="feather-instagram"></i>
                                </a>
                            </li>
                        </ul>
                        <div class="contact-btn mt--30">
                            <a class="rbt-btn hover-icon-reverse btn-border-gradient radius-round" href="@Url.Action("ContactUs","ContactUs", new { area = "" })">
                                <div class="icon-reverse-wrapper">
                                    <span class="btn-text">Contact With Us</span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <h5 class="ft-title">Useful Links</h5>
                        <ul class="ft-link">
                            <li>
                                <a href="@Url.Action("FAQ","Index", new { area = "" })">FAQ</a>
                            </li>
                            <li>
                                <a href="@Url.Action("AboutUs","AboutUs", new { area = "" })">About Us</a>
                            </li>
                            <li>
                                <a href="@Url.Action("PrivacyPolicy","PrivacyPolicy", new { area = "" })">Privacy policy</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <h5 class="ft-title">Our Company</h5>
                        <ul class="ft-link">
                            <li>
                                <a href="@Url.Action("ContactUs","ContactUs", new { area = "" })">Contact Us</a>
                            </li>
                            <li>
                                <a href="@Url.Action("Blog","Blog", new { area = "" })">Blog</a>
                            </li>
                            <li>
                                <a href="@Url.Action("AllCourses","Courses", new { area = "" })">Course</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <h5 class="ft-title">Get Contact</h5>
                        <ul class="ft-link">
                            <li>Phone: <a href="#">08 7119 6196</a></li>
                            <li>E-mail: <a href="mailto:info@courseshub.com.au">info@courseshub.com.au</a></li>
                            <li>Address: <a href="#">Level 1/118 King William Street Adelaide SA 5000</a></li>
                        </ul>
                        <h6 class="w-600 mt--25" style="color: var(--heading-color);">Newsletter</h6>
                        @* Newsletter: assets/js/newsletter.js submits this without leaving the page (NewsletterController.Subscribe) *@
                        <form action="@Url.Action("Subscribe", "Newsletter", new { area = "" })" method="post" class="newsletter-form-1 version-02 mt--15 radius-round js-newsletter-form" data-no-loader novalidate autocomplete="off">
                            @Html.AntiForgeryToken()
                            <label class="nl-visually-hidden" for="newsletterEmail">Email address</label>
                            <input class="rbt-border" id="newsletterEmail" name="email" type="email" placeholder="Enter Your E-Mail" autocomplete="off" maxlength="256" required>
                            @* hidden from people; bots that fill it in are ignored *@
                            <input class="nl-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
                            <button class="rbt-btn rbt-switch-btn btn-gradient radius-round btn-md" type="submit">
                                <span data-text="Subscribe">Subscribe</span>
                            </button>
                        </form>
                        <p class="nl-message" role="status" aria-live="polite" hidden></p>
                        <script src="@CoursesHub.AssetVersion.Url("~/assets/js/newsletter.js")" defer></script>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="rbt-separator-mid">
        <div class="container">
            <hr class="rbt-separator m-0">
        </div>
    </div>
    <br />
    <div class="copyright-area copyright-style-1 ptb--20">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-12 col-12">
                    <p class="rbt-link-hover text-center text-lg-start">
                        Copyright ©
                        <script>
                            var CurrentYear = new Date().getFullYear()
                            document.write(CurrentYear)</script>
                        <a href="@Url.Action("Index","Index", new { area = "" })">Courses Hub</a> All Rights Reserved
                    </p>
                </div>
                <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-12 col-12">
                    <ul class="copyright-link rbt-link-hover justify-content-center justify-content-lg-end mt_sm--10 mt_md--10">
                        <li><a href="@Url.Action("Terms","Index", new { area = "" })">Terms of service</a></li>
                        <li><a href="@Url.Action("PrivacyPolicy","PrivacyPolicy", new { area = "" })">Privacy policy</a></li>
                        <li><a href="@Url.Action("Registration","Registration", new { area = "" })">Register</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</footer>
