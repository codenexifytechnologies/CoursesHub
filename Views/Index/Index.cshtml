    @{
        // Up to 6 trending courses, one card per course (the same course from several providers is shown once)
        var trending = (allCourses ?? new List<CoursesHub.Areas.Panel.Models.CourseDetails>())
            .Where(x => CoursesHub.Models.CourseFilterHelper.IsTrending(x.TrendingCourses))
            .GroupBy(x => (CoursesHub.Models.CourseFilterHelper.CourseCode(x.CourseName) ?? CoursesHub.Models.CourseFilterHelper.CourseTitle(x.CourseName)).ToLowerInvariant())
            .Select(g => g.First())
            .Take(6)
            .ToList();
    }
    @if (trending.Count > 0)
    {
    <div class="rbt-course-area rbt-section-gap home-trending">
        <span class="tp-blob tp-blob-1" aria-hidden="true"></span>
        <span class="tp-blob tp-blob-2" aria-hidden="true"></span>
        <div class="container">
            <div class="section-title text-center ht-head" data-sal="slide-up" data-sal-duration="700">
                <span class="subtitle bg-primary-opacity">Top Trending Course</span>
                <h2 class="title w-600 color-white">Get job-ready with these <span class="ht-accent">popular courses</span></h2>
                <p class="ht-intro">These courses are designed to give you practical, job-ready skills that stay relevant in a changing workplace.</p>
            </div>

            <div class="ht-list">
                @for (int t = 0; t < trending.Count; t++)
                {
                    var item = trending[t];
                    var tCode = CoursesHub.Models.CourseFilterHelper.CourseCode(item.CourseName);
                    var tTitle = CoursesHub.Models.CourseFilterHelper.CourseTitle(item.CourseName);
                    var tAbout = CoursesHub.Models.CourseFilterHelper.PlainText(item.AboutCourse, 420);
                    var tCareers = CoursesHub.Models.CourseFilterHelper.CareerChips(item.CourseOutcomes);
                    var tLevel = CoursesHub.Models.CourseFilterHelper.Qualification(item);
                    var tDetailsUrl = Url.Action("CourseDetails", "Courses", new { CourseId = item.Id });
                    // "Find a provider": compare every provider that offers this course
                    var tProvidersUrl = Url.Action("FindProvider", "Courses", new { area = "", course = tCode ?? tTitle });

                    <article class="ht-card" style="--ht-i:@t" data-sal="slide-up" data-sal-delay="@((t % 2) * 120 + (t / 2) * 80)" data-sal-duration="700">
                        <div class="ht-main">
                            <div class="ht-tags">
                                @if (!string.IsNullOrEmpty(tCode))
                                {
                                    <span class="ht-code">@tCode</span>
                                }
                                @if (!string.IsNullOrEmpty(item.CategoryName))
                                {
                                    <span class="ht-cat">@item.CategoryName</span>
                                }
                            </div>
                            <h3 class="ht-title"><a href="@tDetailsUrl">@tTitle</a></h3>
                            @if (!string.IsNullOrEmpty(tAbout))
                            {
                                <p class="ht-about">@tAbout</p>
                            }
                            @if (tCareers.Count > 0)
                            {
                                <h4 class="ht-label">Career opportunities</h4>
                                <ul class="ht-chips">
                                    @foreach (var career in tCareers)
                                    {
                                        <li>@career</li>
                                    }
                                </ul>
                            }
                        </div>
                        <aside class="ht-side">
                            <dl class="ht-facts">
                                <div>
                                    <dt><i class="feather-clock"></i> Duration</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(item.CourseDuration) ? "Contact provider" : item.CourseDuration + " Weeks")</dd>
                                </div>
                                <div>
                                    <dt><i class="feather-monitor"></i> Study mode</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(item.StudyMethod) ? "Contact provider" : item.StudyMethod)</dd>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(tLevel))
                                {
                                    <div>
                                        <dt><i class="feather-award"></i> Qualification</dt>
                                        <dd>@tLevel</dd>
                                    </div>
                                }
                            </dl>
                            @* Opens the Find a provider questions; the link is the fallback without JavaScript *@
                            <a class="ht-btn" href="@tProvidersUrl" data-find-provider="@(tCode ?? tTitle)" data-course-code="@tCode" data-course-title="@tTitle"><i class="feather-search"></i> Find a provider</a>
                            <a class="ht-link" href="@tDetailsUrl">View course details <i class="feather-arrow-right"></i></a>
                        </aside>
                    </article>
                }
            </div>
        </div>
    </div>
    }



    @{
        var reviews = ViewBag.Testimonials as List<CoursesHub.Areas.Panel.Models.Testimonial> ?? new List<CoursesHub.Areas.Panel.Models.Testimonial>();
    }
    @if (reviews.Count > 0)
    {
    <div id="reviews" class="rbt-testimonial-area home-reviews rbt-section-gap">
        <span class="hr-blob hr-blob-1" aria-hidden="true"></span>
        <span class="hr-blob hr-blob-2" aria-hidden="true"></span>
        <span class="hr-blob hr-blob-3" aria-hidden="true"></span>
        <div class="container">
            <div class="row mb--40">
                <div class="col-lg-12">
                    <div class="section-title text-center" data-sal="slide-up" data-sal-duration="700">
                        <span class="subtitle bg-primary-opacity">Testimonials</span>
                        <h2 class="title w-600">What Our <span class="theme-gradient">Students Say</span></h2>
                        <p class="description hr-intro">Real feedback from learners who found their course with Courses Hub.</p>
                    </div>
                </div>
            </div>
            <div class="testimonial-item-3-activation swiper rbt-arrow-between gutter-swiper-30">
                <div class="swiper-wrapper">
                    @foreach (var item in reviews)
                    {
                        <div class="swiper-slide">
                            <div class="single-slide">
                                @Html.Partial("~/Views/Shared/_ReviewCard.cshtml", item)
                            </div>
                        </div>
                    }

                </div>

                <div class="rbt-swiper-arrow rbt-arrow-left" role="button" tabindex="0" aria-label="Previous reviews">
                    <div class="custom-overfolow">
                        <i class="rbt-icon feather-arrow-left"></i>
                        <i class="rbt-icon-top feather-arrow-left"></i>
                    </div>
                </div>

                <div class="rbt-swiper-arrow rbt-arrow-right" role="button" tabindex="0" aria-label="Next reviews">
