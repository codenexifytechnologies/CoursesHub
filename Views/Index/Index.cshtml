@{
    ViewBag.Title = "CoursesHub";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int i = 0;
    int j = 0;
    var categories = ViewBag.Category as List<CoursesHub.Models.Category>;
    var allCourses = ViewBag.All as List<CoursesHub.Areas.Panel.Models.CourseDetails>;
    var Blogs = ViewBag.Blog as List<CoursesHub.Areas.Admin.Models.Blogs>;
    var lstCategory = ViewBag.lstCategory as List<CoursesHub.Models.Category>;
}

@if (TempData["Message"] != null)
{
    <script src="//code.jquery.com/jquery-2.2.4.min.js"></script>
    <script src="~/assets/js/toastr.min.js"></script>
    <link href="~/assets/css/toastr.min.css" rel="stylesheet" />
    <script>
        $(document).ready(function () {
            toastr.info('@TempData["Message"]');
        });
    </script>
}

<style>
    .tab-scroll-container {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

    .tabs-wrapper {
        overflow-x: auto;
        scroll-behavior: smooth;
        white-space: nowrap;
        width: 100%;
    }

        /* hide default scrollbar */
        .tabs-wrapper::-webkit-scrollbar {
            display: none;
        }

    .rbt-course-tab-button {
        display: inline-flex;
        gap: 10px;
    }

        .rbt-course-tab-button .nav-item {
            display: inline-block;
        }

    .scroll-btn {
        background: transparent;
        border: none;
        font-size: 24px;
        padding: 5px 20px;
        cursor: pointer;
        color: #333;
        font-weight: bold;
    }

        .scroll-btn:hover {
            color: #000;
        }
</style>

<main class="rbt-main-wrapper">
    <div class="rbt-banner-area rbt-banner-17">
        <div class="wrapper">
            <div class="shape-wrap">
                <div class="shape-bg">
                </div>
                <div class="shadow-bg">
                    <img src="@Url.Content("~/assets/images/banner/banner.png")" alt="Banner Background" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; z-index: -1;">
                </div>
                <div class="shape-1">
                    <img src="~/assets/images/shape/o-shape-1.png" alt="Banner Shape">
                </div>
                <div class="shape-2">
                    <img src="~/assets/images/shape/o-shape-2.png" alt="Banner Shape">
                </div>
                <div class="union">
                    <img src="~/assets/images/shape/o-union.png" alt="Banner Shape">
                </div>
                <div class="star scene">
                    <span data-depth="1">
                        <img src="~/assets/images/shape/o-star.png" alt="Banner Shape">
                    </span>
                </div>
                <div class="dot-shape-1">
                    <img src="~/assets/images/shape/o-dots-1.png" alt="Banner Shape">
                </div>
                <div class="dot-shape-2">
                    <span>
                        <img src="~/assets/images/shape/o-dots-2.png" alt="Banner Shape">
                    </span>
                </div>
            </div>
            <div class="container">
                <div class="row flex-column-reverse flex-xl-row">
                    <div class="col-xl-7">
                        <div class="inner position-relative">
                            <h1 class="title">Find the Right Course & Training in <span class="theme-gradient">Australia</span></h1>
                            <p class="description">
                                Discover and compare courses, training providers and qualifications
                                across Australia <span class="w-500">to find the right study option for your career.</span>
                            </p>
                            <div class="button-group mb-3">
                                <a class="rbt-btn btn-gradient hover-icon-reverse" href="@Url.Action("CareerChange", "Index")">
                                    <span class="icon-reverse-wrapper">
                                        <span class="btn-text">Get Started</span>
                                        <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                        <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    </span>
                                </a>
                            </div>
                            <div class="card-row mt-4 mb-5">
                                @* The whole box is the link *@
                                <a class="card-option" href="@Url.Action("AllCourses", "Courses", new { FilterType = "CategoryType", FilterValue = "Latest" })">
                                    <img src="~/assets/images/icons/employment-promotion.svg" alt="" />
                                    <p>Latest</p>
                                </a>
                                <a class="card-option" href="@Url.Action("AllCourses", "Courses", new { FilterType = "CategoryType", FilterValue = "Popular" })">
                                    <img src="~/assets/images/icons/upgrade.svg" alt="" />
                                    <p>Popular</p>
                                </a>
                                <a class="card-option" href="@Url.Action("AllCourses", "Courses", new { FilterType = "CategoryType", FilterValue = "Core" })">
                                    <img src="~/assets/images/icons/work-ui.svg" alt="" />
                                    <p>Core</p>
                                </a>
                                <a class="card-option" href="@Url.Action("AllCourses", "Courses", new { FilterType = "CategoryType", FilterValue = "Master" })">
                                    <img src="~/assets/images/icons/stack.svg" alt="" />
                                    <p>Master</p>
                                </a>
                            </div>
                            <div class="line-arrow scene">
                                <span data-depth="1">
                                    <img src="~/assets/images/shape/o-line-arrow.png" alt="Banner Shape">
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-5">
                        <div class="banner-wrap">
                            <div class="banner">
                                <img src="~/assets/images/banner/o-banner.png" alt="Banner">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* How Courses Hub helps: three steps, shown before the Training Providers section *@
    <section class="home-steps" aria-label="How Courses Hub helps you">
        <div class="container">
            <div class="hs-grid">
                <a class="hs-card" href="@Url.Action("AllCourses", "Courses", new { area = "" })" style="--hs-i:0" data-sal="slide-up" data-sal-delay="0" data-sal-duration="700">
                    <span class="hs-step">01</span>
                    <span class="hs-icon" aria-hidden="true"><i class="feather-compass"></i></span>
                    <h3 class="hs-title">Discover your Path</h3>
                    <p class="hs-text">Explore courses that align with your goals, interests and career aspirations.</p>
                    <span class="hs-more">Explore courses <i class="feather-arrow-right"></i></span>
                </a>
                <a class="hs-card" href="@Url.Action("TrainingProviders", "Courses", new { area = "" })" style="--hs-i:1" data-sal="slide-up" data-sal-delay="150" data-sal-duration="700">
                    <span class="hs-step">02</span>
                    <span class="hs-icon" aria-hidden="true"><i class="feather-book-open"></i></span>
                    <h3 class="hs-title">Learn with Purpose</h3>
                    <p class="hs-text">Build practical skills and knowledge that can help you move forward in your career.</p>
                    <span class="hs-more">Meet our providers <i class="feather-arrow-right"></i></span>
                </a>
                <a class="hs-card" href="@Url.Action("Registration", "Registration", new { area = "" })" style="--hs-i:2" data-sal="slide-up" data-sal-delay="300" data-sal-duration="700">
                    <span class="hs-step">03</span>
                    <span class="hs-icon" aria-hidden="true"><i class="feather-trending-up"></i></span>
                    <h3 class="hs-title">Take the Next Step</h3>
                    <p class="hs-text">Turn your learning goals into action and start building the future you want.</p>
                    <span class="hs-more">Get started for free <i class="feather-arrow-right"></i></span>
                </a>
            </div>
        </div>
    </section>

    <div class="rbt-categories-area bg-color-white rbt-section-gap home-providers">
        <div class="container">
            <div class="row g-5 mb--30">
                <div class="col-lg-12">
                    <div class="section-title text-center">
                        <span class="subtitle bg-primary-opacity">TRAINING PROVIDERS</span>
                        <h2 class="title w-600">Popular with <span class="theme-gradient">other students</span></h2>
                        <p class="description has-medium-font-size mt--20 mb--0">Trusted, registered training organisations offering nationally recognised courses. Pick a provider to explore all of their courses.</p>
                    </div>
                </div>
            </div>
            <div id="DivUnivercity" class="row g-5 justify-content-center">
                @* Home shows at most 8 providers (most courses first); "View All" lists every provider *@
                @foreach (var item in ((List<CoursesHub.Areas.Panel.Models.CourseDetails>)ViewBag.Provider)
                                        .OrderByDescending(x => x.Count)
                                        .ThenBy(x => x.UniversityName, StringComparer.OrdinalIgnoreCase)
                                        .Take(8))
                {
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <a class="rbt-cat-box rbt-cat-box-1 provider-card" href="@Url.Action("AllCourses", "Courses", new { area = "", FilterType = "Provider", FilterValue = item.UniversityName })" title="View courses by @item.UniversityName">
                            <div class="inner">
                                <div class="thumbnail">
                                    <img loading="lazy" decoding="async" src="@item.UniversityLogo" alt="@item.UniversityName logo">
                                </div>
                                <div class="content">
                                    <h5 class="title">@item.UniversityName</h5>
                                    <div class="read-more-btn">
                                        <span class="rbt-btn-link">@item.Count @(item.Count == 1 ? "Course" : "Courses")<i class="feather-arrow-right"></i></span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
            <div class="home-providers-more">
                <a class="bl-btn" href="@Url.Action("TrainingProviders", "Courses", new { area = "" })">View All Training Providers <i class="feather-arrow-right"></i></a>
            </div>

        </div>
    </div>

    @* Small call-to-action banner (same background as the Training Providers banner); the button opens the Get Started page *@
    <section class="home-cta" aria-label="Get course advice">
        <div class="container">
            <div class="hc-banner" data-sal="slide-up" data-sal-duration="700">
                <span class="tp-blob tp-blob-1" aria-hidden="true"></span>
                <span class="tp-blob tp-blob-2" aria-hidden="true"></span>
                <span class="hc-icon" aria-hidden="true"><i class="feather-target"></i></span>
                <div class="hc-text">
                    <h2 class="hc-title">Not sure which course is <span>right for you?</span></h2>
                    <p class="hc-desc">Tell us a little about your goals and we'll help you find courses and training providers that match your career plans.</p>
                </div>
                <a class="hc-btn" href="@Url.Action("CareerChange", "Index", new { area = "" })">
                    Get Started <i class="feather-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <div class="rbt-category-area category-section-02 bg-color-white rbt-section-gap">
        <div class="gradient-shape"></div>
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title text-center">
                        <span class="subtitle bg-primary-opacity">CATEGORIES</span>
                        <h2 class="title w-600 text-center">Explore Courses by <span class="theme-gradient">Field of Study</span></h2>
                    </div>
                </div>
            </div>
            @* Same boxes as the All Categories page; at most 8 here, the rest are on that page *@
            @{ var homeCategories = (lstCategory ?? new List<CoursesHub.Models.Category>()).Take(8).ToList(); }
            <div class="cg-grid home-cg-grid">
                @for (int n = 0; n < homeCategories.Count; n++)
                {
                    var item = homeCategories[n];
                    <a class="cg-card" style="--cg-i:@n" href="@Url.Action("AllCourses", "Courses", new { area = "", FilterType = "CategoryId", FilterValue = item.Id })" title="@item.CategoryValue">
                        <span class="cg-icon">
                            <img loading="lazy" decoding="async" src="@(string.IsNullOrEmpty(item.ImagePath) ? "/assets/images/course/course-01.jpg" : item.ImagePath)" alt="" onerror="this.onerror=null;this.src='/assets/images/course/course-01.jpg';">
                        </span>
                        <span class="cg-body">
                            <span class="cg-name">@item.CategoryValue</span>
                            <span class="cg-count">@item.Count @(item.Count == 1 ? "Course" : "Courses")</span>
                        </span>
                        <span class="cg-arrow" aria-hidden="true"><i class="feather-arrow-right"></i></span>
                    </a>
                }
            </div>
            <div class="home-providers-more home-categories-more">
                <a class="bl-btn" href="@Url.Action("Categories", "Courses", new { area = "" })">View All Categories <i class="feather-arrow-right"></i></a>
            </div>
        </div>
    </div>

    @{
        // Featured courses (set by the admin): High, Medium, Low, newest first; only 6 on the home page
        var allFeatured = CoursesHub.Models.CourseFilterHelper.FeaturedCourses(allCourses);
        var featuredCourses = allFeatured.Take(6).ToList();
    }
    @if (featuredCourses.Count > 0)
    {
    <section class="home-featured rbt-section-gap" aria-labelledby="featuredTitle">
        <span class="hf-blob hf-blob-1" aria-hidden="true"></span>
        <span class="hf-blob hf-blob-2" aria-hidden="true"></span>
        <div class="container">
            <div class="section-title text-center hf-head" data-sal="slide-up" data-sal-duration="700">
                <span class="subtitle bg-primary-opacity">Featured Courses</span>
                <h2 class="title w-600" id="featuredTitle">Hand-picked <span class="theme-gradient">courses for you</span></h2>
                <p class="hf-intro">Top courses selected by our team from trusted training providers across Australia.</p>
            </div>

            <div class="hf-grid">
                @for (int f = 0; f < featuredCourses.Count; f++)
                {
                    @Html.Partial("~/Views/Courses/_FeaturedCourseCard.cshtml", featuredCourses[f], new ViewDataDictionary { { "Index", f }, { "UseSal", true } })
                }
            </div>

            <div class="home-providers-more home-categories-more">
                <a class="bl-btn" href="@Url.Action("FeaturedCourses", "Courses", new { area = "" })">View All Featured Courses <i class="feather-arrow-right"></i></a>
            </div>
        </div>
    </section>
    }

