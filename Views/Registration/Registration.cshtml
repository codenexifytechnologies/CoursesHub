@section scripts{
    <script src="~/assets/js/vendor/bootstrap-select.min.js"></script>
    <script src="@CoursesHub.AssetVersion.Url("~/assets/js/main.js")"></script>
    <script src="~/Plugins/jquery-validation/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js"></script>
    <script>
        /* ---------- Validation rules (same rules as before) ---------- */
        $.validator.addMethod("lettersonly", function (value, element) {
            return this.optional(element) || /^[a-zA-Z]+$/.test(value);
        }, "Please enter letters only.");

        $.validator.addMethod("flexibleurl", function (value, element) {
            if (this.optional(element)) { return true; }
            var pattern = /^(https?:\/\/)?(www\.)?([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}(\/.*)?$/i;
            return pattern.test(value);
        }, "Please enter a valid URL (with or without http/https).");

        $.validator.addMethod("sixdigit", function (value, element) {
            if (this.optional(element)) { return true; }
            return /^\d{5}$/.test(value);
        }, "Please enter exactly 5 digits.");

        $.validator.addMethod("fiveDigitE", function (value, element) {
            if (this.optional(element)) { return true; }
            return /^\d{5}E$/.test(value);
        }, "Please enter 5 digits followed by 'E' (e.g., 12345E).");

        $.validator.addMethod("nineOrElevenDigits", function (value, element) {
            if (this.optional(element)) { return true; }
            return /^(\d{9}|\d{11})$/.test(value);
        }, "Please enter exactly 9 or 11 digits.");

        $.validator.addMethod("strongPassword", function (value, element) {
            if (this.optional(element)) { return true; }
            return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&#])[A-Za-z\d@@$!%*?&#]{6,}$/.test(value);
        }, "Password must contain at least 1 uppercase, 1 lowercase, 1 number, and 1 special character.");

        // Optional JPG/PNG upload, max 2 MB (matches the server check)
        $.validator.addMethod("imageFile", function (value, element) {
            if (!element.files || element.files.length === 0) { return true; }
            var f = element.files[0];
            return /\.(jpe?g|png)$/i.test(f.name) && f.size <= 2 * 1024 * 1024;
        }, "Please choose a JPG or PNG image of 2 MB or less.");

        // Put client messages in the same slot as server messages for that field
        function placeError(error, element) {
            var holder = $('[data-valmsg-for="' + element.attr('name') + '"]');
            if (holder.length) {
                holder.empty().append(error);
            } else {
                error.insertAfter(element);
            }
        }
        function markInvalid(element) {
            $(element).addClass('is-invalid');
            $(element).closest('.bootstrap-select').addClass('is-invalid');
        }
        function markValid(element) {
            $(element).removeClass('is-invalid');
            $(element).closest('.bootstrap-select').removeClass('is-invalid');
        }
        function showLoader() {
            if (window.CHLoader) { CHLoader.show("Loading…"); }
        }

        // Show / hide password
        $(document).on('click', '.reg-eye', function () {
            var input = $($(this).data('toggle-password'));
            var show = input.attr('type') === 'password';
            input.attr('type', show ? 'text' : 'password');
            $(this).attr({ 'aria-pressed': show, 'aria-label': show ? 'Hide password' : 'Show password' })
                .find('i').toggleClass('fa-eye', !show).toggleClass('fa-eye-slash', show);
        });

        $(document).ready(function () {

            /* ---------- Student form ---------- */
            var $student = $('#Student');
            if ($student.length) {
                var studentValidator = $student.validate({
                    onsubmit: false,
                    // the post code lives in a hidden input (the picker is plugin UI), so validate that one
                    ignore: ':hidden:not(#hiddenZipcode), .bs-searchbox input',
                    rules: {
                        'objStudentRegistration.FirstName': { required: true, lettersonly: true },
                        'objStudentRegistration.MiddleName': { lettersonly: true },
                        'objStudentRegistration.LastName': { required: true, lettersonly: true },
                        'objStudentRegistration.EmailId': { required: true, email: true },
                        'objStudentRegistration.Mobile': { required: true, digits: true, minlength: 10, maxlength: 15 },
                        'objStudentRegistration.Password': { required: true, minlength: 6, strongPassword: true },
                        'objStudentRegistration.Zipcode': {
                            required: function () { return $('#objStudentRegistration_isAustraliaResident').is(':checked'); }
                        },
                        'objStudentRegistration.Country': {
                            required: function () { return !$('#objStudentRegistration_isAustraliaResident').is(':checked'); }
                        },
                        'objStudentRegistration.State': { required: true }
                    },
                    messages: {
                        'objStudentRegistration.FirstName': "Please enter your first name",
                        'objStudentRegistration.LastName': "Please enter your last name",
                        'objStudentRegistration.EmailId': { required: "Please enter your email", email: "Please enter a valid email" },
                        'objStudentRegistration.Mobile': {
                            required: "Please enter your mobile number",
                            digits: "Only digits allowed",
                            minlength: "Mobile number must be at least 10 digits",
                            maxlength: "Mobile number must not exceed 15 digits"
                        },
                        'objStudentRegistration.Password': { required: "Please enter a password", minlength: "Password must be at least 6 characters long" },
                        'objStudentRegistration.Zipcode': { required: "Post Code is required for Australian residents" },
                        'objStudentRegistration.Country': { required: "Country is required for non-Australian residents" },
                        'objStudentRegistration.State': { required: "Please Select State" }
                    },
                    errorElement: 'span',
                    errorClass: 'text-danger',
                    errorPlacement: placeError,
                    highlight: markInvalid,
                    unhighlight: markValid
                });

                var studentSubmitting = false;
                $student.on('submit', function (e) {
                    if (studentSubmitting) { e.preventDefault(); return false; }
                    if (!$student.valid()) {
                        e.preventDefault();
                        if (studentValidator.errorList.length) { $(studentValidator.errorList[0].element).trigger('focus'); }
                        return false;
                    }
                    // Prevent duplicate submissions
                    studentSubmitting = true;
                    // post the type exactly once: move it from the (now disabled) button to a hidden field
                    $student.find('button[type="submit"]').removeAttr('name').prop('disabled', true).find('.btn-text').text('Creating your account...');
                    $('<input type="hidden" name="submitButton" value="Student" />').appendTo($student);
                    showLoader();
                    return true;
                });

                function toggleResidency() {
                    if ($("#objStudentRegistration_isAustraliaResident").is(":checked")) {
                        $("#zipcodeBox").show();
                        $("#countryBox").hide();
                    } else {
                        $("#zipcodeBox").hide();
                        $("#countryBox").show();
                    }
                }
                $("#objStudentRegistration_isAustraliaResident").on('change', toggleResidency);
                toggleResidency(); // keep the right fields visible after a server-side error

                $('#objStudentRegistration_Zipcode').on('changed.bs.select', function () {
                    $('#hiddenZipcode').val($(this).selectpicker('val'));
                    studentValidator.element('#hiddenZipcode');
                });
            }

            /* ---------- Training provider wizard ---------- */
            var $form = $('#University');
            if ($form.length) {
                var total = $form.find('.wizard-step').length;
                var current = 1;
                var submitting = false;

                var validator = $form.validate({
                    onsubmit: false,
                    // validate fields in every step (hidden steps included); skip plugin-generated controls
                    ignore: '.bs-searchbox input, .dropdown-toggle, #objUniversityRegistration_Zipcode, :button',
                    rules: {
                        'objUniversityRegistration.RTO_ID': { required: true, number: true, sixdigit: true },
                        'objUniversityRegistration.CRICOS_Code': { fiveDigitE: true },
                        'objUniversityRegistration.Legal_Name_Organisation': { required: true },
                        'objUniversityRegistration.ABN_ACN': { required: true, nineOrElevenDigits: true },
                        'objUniversityRegistration.Business_Address': { required: true },
                        'objUniversityRegistration.Postal_Address': { required: true },
                        'objUniversityRegistration.Website': { flexibleurl: true },
                        'objUniversityRegistration.Contact_Number': { required: true, number: true },
                        'objUniversityRegistration.General_Contact_Email': { required: true, email: true },
                        'objUniversityRegistration.Full_Name': { required: true },
                        'objUniversityRegistration.Position': { required: true },
                        'objUniversityRegistration.Direct_Phone': { required: true, number: true },
                        'objUniversityRegistration.Email': { required: true, email: true },
                        'objUniversityRegistration.Relevant_Courses': { required: true },
                        'objUniversityRegistration.Zipcode': { required: true },
                        'objUniversityRegistration.State': { required: true },
                        'confirmation': { required: true },
                        'Sign': { imageFile: true },
                        'Logo': { imageFile: true }
                    },
                    messages: {
                        'objUniversityRegistration.RTO_ID': { required: "Please enter RTO ID", number: "Please enter numbers only", sixdigit: "Please enter exactly 5 numeric digits (e.g. 12345)" },
                        'objUniversityRegistration.CRICOS_Code': { fiveDigitE: "Please enter exactly 5 digits followed by uppercase 'E' (e.g., 12345E)" },
                        'objUniversityRegistration.Legal_Name_Organisation': { required: "Please enter Legal Name of Organisation" },
                        'objUniversityRegistration.ABN_ACN': { required: "Please enter ABN/ACN", nineOrElevenDigits: "Please enter exactly 9 or 11 numeric digits" },
                        'objUniversityRegistration.Business_Address': { required: "Please enter Business Address" },
                        'objUniversityRegistration.Postal_Address': { required: "Please enter Postal Address" },
                        'objUniversityRegistration.Website': { flexibleurl: "Please enter a valid Website URL (e.g. example.com or https://example.com)" },
                        'objUniversityRegistration.Contact_Number': { required: "Please enter Contact Number", number: "Please enter digits only" },
                        'objUniversityRegistration.General_Contact_Email': { required: "Please enter General Contact Email", email: "Please enter a valid General Contact Email" },
                        'objUniversityRegistration.Full_Name': { required: "Please enter Full Name" },
                        'objUniversityRegistration.Position': { required: "Please enter Position / Job Title" },
                        'objUniversityRegistration.Direct_Phone': { required: "Please enter Direct Phone", number: "Please enter digits only" },
                        'objUniversityRegistration.Email': { required: "Please enter Email", email: "Please enter a valid Email" },
                        'objUniversityRegistration.Relevant_Courses': { required: "Please select at least one course" },
                        'objUniversityRegistration.Zipcode': { required: "Please select Post Code" },
                        'objUniversityRegistration.State': { required: "Please select State" },
                        'confirmation': { required: "Please confirm the compliance statements" }
                    },
                    errorElement: 'span',
                    errorClass: 'text-danger',
                    errorPlacement: placeError,
                    highlight: markInvalid,
                    unhighlight: markValid
                });

                function stepEl(n) { return $form.find('.wizard-step[data-step="' + n + '"]'); }

                function stepFields(n) {
                    return stepEl(n).find('input, select, textarea')
                        .filter('[name]')
                        .not(':button, .bs-searchbox input, #objUniversityRegistration_Zipcode, [name="__RequestVerificationToken"]')
                        .filter(function () { return this.type !== 'hidden' || this.id === 'hiddenUZipcode'; });
                }

                // Validate only the given step; returns true when every field passes
                function validateStep(n) {
                    var ok = true, first = null;
                    stepFields(n).each(function () {
                        if (validator.element(this) === false) {
                            ok = false;
                            if (!first) { first = this; }
                        }
                    });
                    if (first) {
                        var $bs = $(first).closest('.bootstrap-select');
                        ($bs.length ? $bs.find('.dropdown-toggle') : $(first)).trigger('focus');
                    }
                    return ok;
                }

                function goTo(n) {
                    current = Math.max(1, Math.min(total, n));
                    $form.find('.wizard-step').removeClass('active');
                    var $step = stepEl(current).addClass('active');

                    $('#wizardStepText').html('<strong>Step ' + current + ' of ' + total + '</strong>');
                    $('#wizardStepName').text($step.data('title'));
                    $('#wizardBar').css('width', (current / total * 100) + '%');

                    $form.find('.wizard-tabs button').each(function () {
                        var s = parseInt($(this).data('goto'), 10);
                        $(this).toggleClass('current', s === current)
                            .toggleClass('done', s < current)
                            .attr('aria-current', s === current ? 'step' : null);
                    });

                    $('#wizardPrev').toggle(current > 1);
                    $('#wizardNext').toggle(current < total);
                    $('#wizardSubmit').toggle(current === total);

                    if (current === total) { buildReview(); }

                    var top = $form.offset().top - 120;
                    if ($(window).scrollTop() > top) { $('html, body').animate({ scrollTop: top }, 200); }
                }

                $('#wizardNext').on('click', function () {
                    if (validateStep(current)) { goTo(current + 1); }
                });

                // Enter in a field moves to the next step instead of submitting early
                $form.on('keydown', 'input', function (e) {
                    if (e.key === 'Enter' && current < total) {
                        e.preventDefault();
                        $('#wizardNext').trigger('click');
                    }
                });
                $('#wizardPrev').on('click', function () { goTo(current - 1); });

                // Progress tabs / review "Edit" buttons: going back is free, going forward validates each step on the way
                $form.on('click', '[data-goto]', function () {
                    var target = parseInt($(this).data('goto'), 10);
                    if (target <= current) { goTo(target); return; }
                    for (var s = current; s < target; s++) {
                        if (!validateStep(s)) { goTo(s); validateStep(s); return; }
                    }
                    goTo(target);
                });

                /* ----- Review summary (built with textContent, never raw HTML) ----- */
                var reviewSections = [
                    { step: 1, title: 'Organisation', fields: [
                        ['objUniversityRegistration_RTO_ID', 'RTO ID'],
                        ['objUniversityRegistration_RTO_Status', 'RTO Status'],
                        ['objUniversityRegistration_Legal_Name_Organisation', 'Legal Name of Organisation'],
                        ['objUniversityRegistration_Trading_Name', 'Trading Name'],
                        ['objUniversityRegistration_CRICOS_Code', 'CRICOS Code'],
                        ['objUniversityRegistration_ABN_ACN', 'ABN / ACN']] },
                    { step: 2, title: 'Address & Contact', fields: [
                        ['objUniversityRegistration_Business_Address', 'Business Address'],
                        ['objUniversityRegistration_Postal_Address', 'Postal Address'],
                        ['hiddenUZipcode', 'Post Code'],
                        ['objUniversityRegistration_State', 'State'],
                        ['objUniversityRegistration_Contact_Number', 'Contact Number'],
                        ['objUniversityRegistration_General_Contact_Email', 'General Contact Email'],
                        ['objUniversityRegistration_Website', 'Website']] },
                    { step: 3, title: 'Key Contact', fields: [
                        ['objUniversityRegistration_Full_Name', 'Full Name'],
                        ['objUniversityRegistration_Position', 'Position / Job Title'],
                        ['objUniversityRegistration_Direct_Phone', 'Direct Phone'],
                        ['objUniversityRegistration_Email', 'Email']] },
                    { step: 4, title: 'Courses & Compliance', fields: [
                        ['objUniversityRegistration_Relevant_Courses', 'Course categories'],
                        ['confirm-checkbox', 'Compliance statements'],
                        ['signFile', 'Authorised Signature'],
                        ['logoFile', 'Logo']] }
                ];

                function displayValue(el) {
                    if (!el) { return ''; }
                    if (el.type === 'checkbox') {
                        return el.id === 'confirm-checkbox' ? (el.checked ? 'Confirmed' : 'Not confirmed') : (el.checked ? 'Yes' : 'No');
                    }
                    if (el.type === 'file') { return el.files && el.files.length ? el.files[0].name : 'Not provided'; }
                    if (el.tagName === 'SELECT') {
                        return $(el).find('option:selected').map(function () { return $(this).text().trim(); }).get().join(', ');
                    }
                    return (el.value || '').trim();
                }

                function buildReview() {
                    var box = document.getElementById('reviewSummary');
                    box.innerHTML = '';
                    reviewSections.forEach(function (sec) {
                        var section = document.createElement('div');
                        section.className = 'review-section';
                        var header = document.createElement('header');
                        var h = document.createElement('span');
                        h.textContent = sec.step + '. ' + sec.title;
                        var edit = document.createElement('button');
                        edit.type = 'button';
                        edit.setAttribute('data-goto', sec.step);
                        edit.textContent = 'Edit';
                        header.appendChild(h);
                        header.appendChild(edit);
                        var dl = document.createElement('dl');
                        sec.fields.forEach(function (f) {
                            var dt = document.createElement('dt');
                            dt.textContent = f[1];
                            var dd = document.createElement('dd');
                            dd.textContent = displayValue(document.getElementById(f[0])) || '—';
                            dl.appendChild(dt);
                            dl.appendChild(dd);
                        });
                        section.appendChild(header);
                        section.appendChild(dl);
                        box.appendChild(section);
                    });
                }

                /* ----- Final submit: validate all steps, then submit once ----- */
                $form.on('submit', function (e) {
                    if (submitting) { e.preventDefault(); return false; }
                    for (var s = 1; s < total; s++) {
                        if (!validateStep(s)) {
                            e.preventDefault();
                            goTo(s);
                            validateStep(s);
                            return false;
                        }
                    }
                    submitting = true;
                    // post the type exactly once: move it from the (now disabled) button to a hidden field
                    $('#wizardSubmit').removeAttr('name').prop('disabled', true).find('.btn-text').text('Loading...');
                    $('#wizardPrev, #wizardNext').prop('disabled', true);
                    $('<input type="hidden" name="submitButton" value="University" />').appendTo($form);
                    showLoader();
                    return true;
                });

                $('#objUniversityRegistration_Zipcode').on('changed.bs.select', function () {
                    $('#hiddenUZipcode').val($(this).selectpicker('val'));
                    validator.element('#hiddenUZipcode');
                });
                $('#objUniversityRegistration_Relevant_Courses').on('changed.bs.select', function () {
                    validator.element(this);
                });
                $('#objUniversityRegistration_State').on('change', function () { validator.element(this); });
                $('#confirm-checkbox').on('change', function () { validator.element(this); });

                // After a server-side error, open the first step that has a field message
                var errStep = 0;
                $form.find('.field-validation-error').each(function () {
                    if ($(this).text().trim().length) {
                        var s = parseInt($(this).closest('.wizard-step').data('step'), 10);
                        if (s && (!errStep || s < errStep)) { errStep = s; }
                    }
                });
                goTo(errStep || 1);
            }

            /* ---------- Post code search (shared) ---------- */
            // Restore a previously chosen post code after a server-side error
            [['#hiddenZipcode', '#objStudentRegistration_Zipcode'], ['#hiddenUZipcode', '#objUniversityRegistration_Zipcode']].forEach(function (pair) {
                var v = $(pair[0]).val();
                if (v && $(pair[1]).length) {
                    $(pair[1]).append(new Option(v, v, true, true));
                    $(pair[1]).selectpicker('refresh');
                }
            });

            $(document).on("input", ".bs-searchbox input", function () {
                var search = $(this).val();
                var $select = $(this).closest('.bootstrap-select').find('select');
                if (search.length < 3 || !/_Zipcode$/.test($select.attr('id') || '')) { return; }
                $.ajax({
                    url: '/Registration/SearchAusZip',
                    type: 'GET',
                    data: { query: search },
                    success: function (data) {
                        $select.empty();
                        $.each(data, function (i, item) {
                            var text = item.Postcode + ' - ' + item.Suburb;
                            $select.append(new Option(text, text));
                        });
                        $select.selectpicker('refresh');
                    }
                });
            });
        });
    </script>
}
