<div class="rbt-course-details-area pb--60 mt--60 mt_md--60 mt_sm--50 cd-page">
    <div class="container">
        <div class="course-details-content version-02 mb--80 mb_md--60 mb_sm--50">
           
            <div class="row align-items-center rbt-index-upper-2">
                <div class="col-lg-8">
                    @if (!string.IsNullOrEmpty(courseCode))
                    {
                        <span class="cd-code">@courseCode</span>
                    }
                    <h2 class="w-600 mb--10 color-white cd-title">@courseTitle</h2>
                    <div class="cd-hero-intro cd-rich mb--20">@Html.Raw(CoursesHub.Models.CourseFilterHelper.CleanRichText(Course.AboutCourse))</div>
                    <hr class="divider">
                    <div class="d-flex align-items-center flex-wrap course-details-feature">

                        <div class="feature-sin">
                            <span class="icon">
                                <i class="feather-user color-white"></i>
                            </span>
                            <h6 class="b3 w-400 mb--0 color-white"><span class="opacity-8">by</span> <a class="color-white" href="#">@Course.CourseProvider</a></h6>
                        </div>

                        <div class="feature-sin">
                            <span class="icon">
                                <i class="feather-calendar color-white"></i>
                            </span>
                            <span class="b3 color-white opacity-8">@Course.CourseStartDate</span>
                        </div>

                        @if (!string.IsNullOrEmpty(Course.CourseDuration))
                        {
                            <div class="feature-sin">
                                <span class="icon">
                                    <i class="feather-clock color-white"></i>
                                </span>
                                <span class="b3 color-white opacity-8">@Course.CourseDuration Weeks</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Course.StudyMethod))
                        {
                            <div class="feature-sin">
                                <span class="icon">
                                    <i class="feather-monitor color-white"></i>
                                </span>
                                <span class="b3 color-white opacity-8">@Course.StudyMethod</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="d-flex justify-content-center mt_md--60 mt_sm--60">
                        @if (!string.IsNullOrEmpty(Course.CourseVideo))
                        {
                            <a class="rbt-btn rounded-player-2 popup-video position-to-top rounded-player" href="@Course.CourseVideo">
                                <span class="play-icon"></span>
                            </a>
                        }
                        else if (!string.IsNullOrEmpty(Course.CourseVideo2))
