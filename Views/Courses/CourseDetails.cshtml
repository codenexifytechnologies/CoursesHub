                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="rbt-instructor rbt-shadow-box intructor-wrapper mt--30" id="workplacement">
                        <div class="about-author border-0 pb--0 pt--0">
                            <div class="section-title mb--30">
                                <h4 class="rbt-title-style-3"><i class="feather-briefcase"></i>Work Placement</h4>
                            </div>
                            @if (!string.IsNullOrEmpty(CoursesHub.Models.CourseFilterHelper.CleanRichText(Course.WorkPlacement)))
                            {
                                <div class="cd-rich">@Html.Raw(CoursesHub.Models.CourseFilterHelper.CleanRichText(Course.WorkPlacement))</div>
                            }
                            else
                            {
                                <p>NA</p>
                            }
                        </div>
                    </div>
                    <div class="rbt-instructor rbt-shadow-box intructor-wrapper mt--30" id="RPL">
                        <div class="about-author border-0 pb--0 pt--0">
                            <div class="section-title mb--30">
                                <h4 class="rbt-title-style-3"><i class="feather-layers"></i>RPL</h4>
                            </div>
                            @if (!string.IsNullOrEmpty(CoursesHub.Models.CourseFilterHelper.CleanRichText(Course.RPL)))
                            {
                                <div class="cd-rich">@Html.Raw(CoursesHub.Models.CourseFilterHelper.CleanRichText(Course.RPL))</div>
                            }
