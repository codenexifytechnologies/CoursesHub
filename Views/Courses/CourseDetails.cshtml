                    @if (UserId != null && !string.IsNullOrEmpty(LoginType) && LoginType == "Student")
                    {
                        <div class="rbt-review-wrapper rbt-shadow-box review-wrapper mt--30" id="review">
                            <div class="course-content">
                                <div class="section-title">
                                    <h4 class="rbt-title-style-3"><i class="feather-edit-3"></i>Your Review</h4>
                                </div>

                                @using (Html.BeginForm("SaveTestimonial", "Courses", FormMethod.Post, new { @class = "max-width-auto", @id = "SaveTestimonial" }))
                                {
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            @Html.TextAreaFor(m => m.Comment)
                                            <label>Comment *</label>
                                            <span class="focus-border"></span>
                                        </div>
                                        <div class="form-submit-group">
                                            <button type="submit" class="rbt-btn btn-md btn-gradient hover-icon-reverse w-100">
                                                <span class="icon-reverse-wrapper">
                                                    <span class="btn-text">Submit</span>
                                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                                </span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (Course.Testimonials != null && Course.Testimonials.Count > 0)
                    {
                        <div class="rbt-testimonial-area bg-color-white rbt-section-gap">
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="section-title">
                                            <h2 class="rbt-title-style-3"><i class="feather-message-circle"></i>Feedback</h2>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-5">
                                    <div class="col-lg-12">
                                        <div class="swiper testimonial-activation-1 rbt-dot-bottom-left pb--60">
                                            <div class="swiper-wrapper">
                                                @foreach (var item in Course.Testimonials)
                                                {
                                                    <div class="swiper-slide">
                                                        <div class="rbt-testimonial-box no-box-shadow bg-gray-light">
                                                            <div class="inner">
                                                                <div class="clint-info-wrapper">
                                                                    <div class="client-info">
                                                                        <h5 class="title">@item.Person_Name</h5>
                                                                        <span>@item.Designation</span>
                                                                    </div>
                                                                </div>
                                                                <div class="description">
                                                                    <p class="subtitle-3">
                                                                        @item.Comment
                                                                    </p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="rbt-swiper-pagination"></div>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>

                @if (UniversityCourses.Count > 0)
                {
                    @* More courses from this provider: same animated card as "Hand-picked courses for you" (no Featured ribbon) *@
                    var providerName = string.IsNullOrWhiteSpace(Course.UniversityName) ? Course.CourseProvider : Course.UniversityName;
                    <div class="related-course cd-more mt--60">
                        <div class="cd-more-head">
                            <div class="section-title">
                                <span class="subtitle bg-primary-opacity">Top Courses</span>
                                <h4 class="title">More Courses by <span class="theme-gradient">@providerName</span></h4>
                            </div>
                            <a class="bl-btn cd-more-all" href="@Url.Action("AllCourses", "Courses", new { area = "", FilterType = "Provider", FilterValue = Course.UniversityName })">View All Courses <i class="feather-arrow-right"></i></a>
                        </div>
                        <div class="hf-grid cd-more-grid">
                            @* first 4 here; "View All Courses" lists every course from this provider *@
                            @for (int m = 0; m < Math.Min(4, UniversityCourses.Count); m++)
                            {
                                @Html.Partial("~/Views/Courses/_FeaturedCourseCard.cshtml", UniversityCourses[m], new ViewDataDictionary { { "Index", m }, { "ShowRibbon", false } })
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="course-sidebar sticky-top rbt-shadow-box rbt-gradient-border">
                    <div class="inner">
                        <div class="cd-sidebar-thumb">
                            <img src="@(string.IsNullOrEmpty(Course.CoursePhoto) ? "/assets/images/event/grid-type-01.jpg" : Course.CoursePhoto)" alt="@Course.CourseName" onerror="this.onerror=null;this.src='/assets/images/event/grid-type-01.jpg';">
                            @if (!string.IsNullOrEmpty(Course.CategoryName))
                            {
                                <span class="cd-sidebar-tag">@Course.CategoryName</span>
                            }
                        </div>
                        <div class="content-item-content">
                            <h5 class="cd-glance-title"><span class="cd-glance-icon" aria-hidden="true"><i class="feather-eye"></i></span> Course at a glance</h5>

                            <div class="add-to-card-button mt--15">
                                @if (Convert.ToBoolean(ViewBag.isStudent))
                                {
                                    @* same button style as "Find a provider" / "View course" *@
                                    <a class="hf-btn cd-connect" onclick="return checklogin();" href="@Url.Action("ConnectToUnivarsity", "Courses", new { area = "", @CourseId = @Course.Id, @UniversityId = Course.UniversityId })">
                                        <i class="feather-send" aria-hidden="true"></i> Connect To Training Provider
                                    </a>
                                }
                            </div>
                            <div class="rbt-widget-details has-show-more">
                                <ul class="has-show-more-inner-content rbt-course-details-list-wrapper">
                                    <li>
                                        <span><i class="feather-calendar"></i>Start Date</span><span class="rbt-feature-value rbt-badge-5">
                                            @Course.CourseStartDate
                                        </span>
                                    </li>
                                    <li>
                                        <span><i class="feather-monitor"></i>Study Mode</span><span class="rbt-feature-value rbt-badge-5">
                                            @Course.StudyMethod
                                        </span>
                                    </li>
                                    <li>
                                        <span><i class="feather-grid"></i>Category</span><span class="rbt-feature-value rbt-badge-5">
                                            @Course.CategoryName
                                        </span>
                                    </li>
                                    <li>
                                        <span><i class="feather-clock"></i>Duration</span><span class="rbt-feature-value rbt-badge-5">
                                            @Course.CourseDuration Weeks
                                        </span>
                                    </li>
                                    <li>
                                        <span><i class="feather-bar-chart-2"></i>Level</span><span class="rbt-feature-value rbt-badge-5">
                                            @(string.IsNullOrEmpty(Course.CourseLevelName) ? "N/A" : Course.CourseLevelName)
                                        </span>
                                    </li>
                                </ul>
                            </div>

                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="rbt-separator-mid">
    <div class="container">
        <hr class="rbt-separator m-0">
    </div>
</div>
@if (SimilarCourses.Count > 0)
{
    @* Related courses: same animated card as "Hand-picked courses for you" (no Featured ribbon); first 6, the rest via View All *@
    <div class="rbt-related-course-area bg-color-white pt--60 rbt-section-gapBottom cd-page cd-related">
        <div class="container">
            <div class="cd-more-head">
                <div class="section-title">
                    <span class="subtitle bg-primary-opacity">More Similar Courses</span>
                    <h4 class="title">Related <span class="theme-gradient">Courses</span></h4>
                </div>
                <a class="bl-btn cd-more-all" href="@(string.IsNullOrWhiteSpace(Course.CourseCategory) ? Url.Action("AllCourses", "Courses", new { area = "" }) : Url.Action("AllCourses", "Courses", new { area = "", FilterType = "CategoryId", FilterValue = Course.CourseCategory }))">View All Courses <i class="feather-arrow-right"></i></a>
            </div>
            <div class="hf-grid">
                @for (int r = 0; r < Math.Min(6, SimilarCourses.Count); r++)
                {
                    @Html.Partial("~/Views/Courses/_FeaturedCourseCard.cshtml", SimilarCourses[r], new ViewDataDictionary { { "Index", r }, { "ShowRibbon", false } })
                }
            </div>
        </div>
    </div>
}
