    <div class="container">
        <hr class="rbt-separator m-0">
    </div>
</div>
<div id="loginPopup" class="custom-popup cd-popup">
    <div class="popup-content">

        <h3 class="popup-title">You are not logged in</h3>

        <!-- Login Section -->
        <p class="popup-msg">Already have an account?</p>
        <a href="@Url.Action("Login", "Login", new { area = "", type = "Student" })" class="popup-btn login-btn">Login</a>

        <!-- Horizontal Line -->
        <div class="popup-separator">
            <span>OR</span>
        </div>

        <!-- Register Section -->
        <p class="popup-msg">New user? Create your account</p>
        <a href="@Url.Action("Registration","Registration", new { area = "", type = "Student" })" class="popup-btn register-btn">Register</a>

        <button type="button" class="popup-close" onclick="closePopup()" aria-label="Close"><i class="feather-x"></i></button>
    </div>
</div>

@section scripts{
    <script src="@CoursesHub.AssetVersion.Url("~/assets/js/main.js")"></script>
    @if (!string.IsNullOrEmpty(toastMessage) || !string.IsNullOrEmpty(toastErrMessage))
    {
        <script src="~/assets/js/toastr.min.js"></script>
        <script>
            $(document).ready(function () {
                // Back/Forward and reload replay this page's HTML; the history entry remembers the toast was shown
                if (history.state && history.state.toastShown) { return; }

                toastr.options = { closeButton: true, progressBar: true, timeOut: 6000, extendedTimeOut: 2000, newestOnTop: true };
                var msg = '@Html.Raw(HttpUtility.JavaScriptStringEncode(toastMessage))';
                var errMsg = '@Html.Raw(HttpUtility.JavaScriptStringEncode(toastErrMessage))';
                if (msg) { toastr.info(msg); }
                if (errMsg) { toastr.error(errMsg); }

                try { history.replaceState($.extend({}, history.state, { toastShown: true }), document.title); } catch (e) { }
            });
            // page restored from the back/forward cache: drop any toast frozen on screen
            window.addEventListener('pageshow', function (e) {
                if (e.persisted) { toastr.remove(); }
            });
        </script>
    }
    <script>
        function checklogin() {
            var isUserLoggedIn = @(isLoggedIn ? "true" : "false");
            if (isUserLoggedIn == true) {
                return true;
            }
            document.getElementById("loginPopup").classList.add("show-popup");
            return false;
        }
        function closePopup() {
            document.getElementById("loginPopup").classList.remove("show-popup");
        }

        $(document).ready(function () {
            $('.video-popup-with-text').magnificPopup({
                type: 'iframe'
            });
        });

        // Fade content cards in as they scroll into view (skipped for reduced-motion users / old browsers)
        (function () {
            if (!('IntersectionObserver' in window) ||
                (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
                return;
            }
            var items = document.querySelectorAll('.cd-page .course-details-content .rbt-shadow-box, .cd-page .related-course .rbt-card, .cd-related .rbt-card');
            var observerFired = false;
            var observer = new IntersectionObserver(function (entries) {
                observerFired = true;
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('cd-in');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
            items.forEach(function (el) {
                el.classList.add('cd-reveal');
                observer.observe(el);
            });
            // safety net: never leave content hidden if the observer doesn't run
            setTimeout(function () {
                if (!observerFired) {
                    items.forEach(function (el) { el.classList.add('cd-in'); });
                    observer.disconnect();
                }
            }, 1500);
        })();
    </script>
}
