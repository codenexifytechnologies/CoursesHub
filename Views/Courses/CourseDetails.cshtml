@model CoursesHub.Areas.Panel.Models.Testimonial
@{
    ViewBag.Title = "CourseDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
    CoursesHub.Models.Registration obj = (CoursesHub.Models.Registration)Session["Registration"];
    string UserId = string.Empty; string LoginType = string.Empty;
    if (obj != null)
    {
        UserId = obj.LoginType == "Student" ? obj.objStudentRegistration.Id.ToString() : obj.objUniversityRegistration.Id.ToString();
        LoginType = obj.LoginType;
    }
    var Course = (CoursesHub.Areas.Panel.Models.CourseDetails)ViewBag.CourseDetails;
    var SimilarCourses = (List<CoursesHub.Areas.Panel.Models.CourseDetails>)ViewBag.SameCourses;
    var UniversityCourses = (List<CoursesHub.Areas.Panel.Models.CourseDetails>)ViewBag.SameUniversity;
    bool isLoggedIn = obj != null && obj.objStudentRegistration != null && obj.objStudentRegistration.Id > 0;
    // "CHC43015 Certificate IV in Ageing Support" -> highlighted code + separate title
    var courseCode = CoursesHub.Models.CourseFilterHelper.CourseCode(Course.CourseName);
    var courseTitle = CoursesHub.Models.CourseFilterHelper.CourseTitle(Course.CourseName);
}

@{
    // read here, shown in the scripts section (toastr needs jQuery, which the layout loads at the bottom)
    string toastMessage = Convert.ToString(TempData["Message"]);
    string toastErrMessage = Convert.ToString(TempData["ErrMessage"]);
}
@if (!string.IsNullOrEmpty(toastMessage) || !string.IsNullOrEmpty(toastErrMessage))
{
    <link href="~/assets/css/toastr.min.css" rel="stylesheet" />
}
<style>
    .custom-popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 99999;
    }

        .custom-popup.show-popup {
            display: flex;
        }

    .popup-content {
        background: #fff;
        padding: 25px 30px;
        border-radius: 12px;
        width: 350px;
        text-align: center;
        position: relative;
    }

    .popup-title {
        margin-bottom: 15px;
        font-size: 20px;
        font-weight: 600;
    }

    .popup-msg {
        font-size: 14px;
        color: #444;
        margin-bottom: 10px;
    }

    .popup-btn {
        display: block;
        width: 100%;
        padding: 12px 0;
        border-radius: 6px;
        color: #fff;
        text-decoration: none;
        margin-bottom: 15px;
        font-size: 15px;
        font-weight: 500;
    }

    .login-btn {
        background: var(--primary-color);
    }

    .register-btn {
        background: #28a745;
    }

    .popup-separator {
        display: flex;
        align-items: center;
        margin: 15px 0;
        font-size: 13px;
        color: #777;
    }

        .popup-separator::before,
        .popup-separator::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #ccc;
        }

        .popup-separator span {
            margin: 0 10px;
            font-weight: 600;
        }

    .popup-close {
        position: absolute;
        top: 5px;
        right: 8px;
        background: none;
        border: none;
        font-size: 22px;
        cursor: pointer;
    }
</style>

