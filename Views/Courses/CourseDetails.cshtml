        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6">
                <div class="section-title text-center text-md-start">
                    <h5 class="title mb--0">@if (!string.IsNullOrEmpty(courseCode)) {<span class="cd-card-code">@courseCode</span>} @courseTitle</h5>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 mt_sm--15">
                <div class="course-action-bottom-right rbt-single-group">
                    <div class="rbt-single-list action-btn">
                        <a class="rbt-btn btn-gradient hover-icon-reverse btn-md" onclick="return checklogin();" href="@Url.Action("ConnectToUnivarsity", "Courses", new { area = "", @CourseId = @Course.Id, @UniversityId = Course.UniversityId })">
                            <span class="icon-reverse-wrapper">
                                <span class="btn-text">Connect To Training Provider</span>
                                <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
