                        </div>
                        <div class="col-6">
                            @if (!string.IsNullOrEmpty(Course.CourseVideo3))
                            {
                                <div class="rbt-instructor rbt-shadow-box intructor-wrapper mt--30" id="CourseVid3">
                                    <div class="about-author border-0 pb--0 pt--0">
                                        <h4 class="rbt-title-style-3">Course Video 3</h4>
                                        <a href="@Course.CourseVideo3" target="_blank" class="video-popup-wrapper text-center mb--15">
                                            <div class="video-content">
