@model List<CoursesHub.Areas.Panel.Models.CourseDetails>
@{
    ViewBag.Title = "Featured Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var courses = Model ?? new List<CoursesHub.Areas.Panel.Models.CourseDetails>();
    int providerCount = courses.Where(c => !string.IsNullOrWhiteSpace(c.UniversityName))
                               .Select(c => c.UniversityName.Trim().ToLowerInvariant()).Distinct().Count();
}

<section class="tp-hero fc-hero">
    <span class="tp-blob tp-blob-1" aria-hidden="true"></span>
    <span class="tp-blob tp-blob-2" aria-hidden="true"></span>
    <div class="container">
        <ul class="page-list bl-crumbs">
            <li class="rbt-breadcrumb-item"><a href="@Url.Action("Index", "Index", new { area = "" })">Home</a></li>
            <li><div class="icon-right"><i class="feather-chevron-right"></i></div></li>
            <li class="rbt-breadcrumb-item active">Featured Courses</li>
        </ul>
        <span class="bl-eyebrow"><i class="feather-star"></i> Featured Courses</span>
        <h1 class="bl-hero-title">Hand-picked courses for you</h1>
        <p class="bl-hero-text">Top courses selected by our team from trusted training providers across Australia.</p>
        <div class="bl-hero-meta">
            <span class="bl-pill"><i class="feather-star"></i> @courses.Count Featured @(courses.Count == 1 ? "Course" : "Courses")</span>
            <span class="tp-pill-ghost"><i class="feather-home"></i> @providerCount @(providerCount == 1 ? "Provider" : "Providers")</span>
        </div>
    </div>
</section>

<div class="fc-area rbt-section-gapBottom">
    <div class="container">
        @if (courses.Count == 0)
        {
            <div class="bl-empty">
                <span class="bl-empty-icon"><i class="feather-star"></i></span>
                <h4>No featured courses yet</h4>
                <p>Featured courses will appear here once they are selected.</p>
                <a class="bl-btn" href="@Url.Action("AllCourses", "Courses", new { area = "" })">Browse all courses <i class="feather-arrow-right"></i></a>
            </div>
        }
        else
        {
            <div class="hf-grid">
                @for (int i = 0; i < courses.Count; i++)
                {
                    @Html.Partial("~/Views/Courses/_FeaturedCourseCard.cshtml", courses[i], new ViewDataDictionary { { "Index", i } })
                }
            </div>
        }
    </div>
</div>
