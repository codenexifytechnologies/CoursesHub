@model CoursesHub.Areas.Panel.Models.CourseDetails
@* Trending course card: home page "Get job-ready with these popular courses" and the Trending Courses page *@
@{
    int index = ViewData["Index"] is int ? (int)ViewData["Index"] : 0;
    // Scroll reveal (data-sal) only where sal.js runs (home page); elsewhere the card fades in with CSS
    bool useSal = ViewData["UseSal"] is bool && (bool)ViewData["UseSal"];
    var salAttributes = useSal ? Html.Raw(" data-sal=\"slide-up\" data-sal-delay=\"" + ((index % 2) * 120 + (index / 2) * 80) + "\" data-sal-duration=\"700\"") : Html.Raw("");

    var code = CoursesHub.Models.CourseFilterHelper.CourseCode(Model.CourseName);
    var title = CoursesHub.Models.CourseFilterHelper.CourseTitle(Model.CourseName);
    var about = CoursesHub.Models.CourseFilterHelper.PlainText(Model.AboutCourse, 420);
    var careers = CoursesHub.Models.CourseFilterHelper.CareerChips(Model.CourseOutcomes);
    var level = CoursesHub.Models.CourseFilterHelper.Qualification(Model);
    var detailsUrl = Url.Action("CourseDetails", "Courses", new { area = "", CourseId = Model.Id });
    // "Find a provider": compare every provider that offers this course
    var providersUrl = Url.Action("FindProvider", "Courses", new { area = "", course = code ?? title });
}
<article class="ht-card" style="--ht-i:@(index % 12)" data-search="@((Model.CourseName + " " + Model.CategoryName + " " + level).ToLowerInvariant())"@salAttributes>
    <div class="ht-main">
        <div class="ht-tags">
            @if (!string.IsNullOrEmpty(code))
            {
                <span class="ht-code">@code</span>
            }
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <span class="ht-cat">@Model.CategoryName</span>
            }
        </div>
        <h3 class="ht-title"><a href="@detailsUrl">@title</a></h3>
        @if (!string.IsNullOrEmpty(about))
        {
            <p class="ht-about">@about</p>
        }
        @if (careers.Count > 0)
        {
            <h4 class="ht-label">Career opportunities</h4>
            <ul class="ht-chips">
                @foreach (var career in careers)
                {
                    <li>@career</li>
                }
            </ul>
        }
    </div>
    <aside class="ht-side">
        <dl class="ht-facts">
            <div>
                <dt><i class="feather-clock"></i> Duration</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.CourseDuration) ? "Contact provider" : Model.CourseDuration + " Weeks")</dd>
            </div>
            <div>
                <dt><i class="feather-monitor"></i> Study mode</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.StudyMethod) ? "Contact provider" : Model.StudyMethod)</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(level))
            {
                <div>
                    <dt><i class="feather-award"></i> Qualification</dt>
                    <dd>@level</dd>
                </div>
            }
        </dl>
        @* Opens the Find a provider questions; the link is the fallback without JavaScript *@
        <a class="ht-btn" href="@providersUrl" data-find-provider="@(code ?? title)" data-course-code="@code" data-course-title="@title"><i class="feather-search"></i> Find a provider</a>
        <a class="ht-link" href="@detailsUrl">View course details <i class="feather-arrow-right"></i></a>
    </aside>
</article>
