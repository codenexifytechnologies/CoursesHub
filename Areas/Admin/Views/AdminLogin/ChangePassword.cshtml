@model CoursesHub.Models.ChangePassword
@{
    Layout = null;
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
<link rel="stylesheet" href="~/Areas/Admin/plugins/fontawesome-free/css/all.min.css">
<link rel="stylesheet" href="~/Areas/Admin/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
<link rel="stylesheet" href="~/Areas/Admin/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="@CoursesHub.AssetVersion.Url("~/Areas/Admin/dist/css/brand-admin.css")">
@Html.Partial("~/Views/Shared/_PageLoader.cshtml")

@if (TempData["Message"] != null)
{
    <script src="//code.jquery.com/jquery-2.2.4.min.js"></script>
    <script src="~/assets/js/toastr.min.js"></script>
     <link href="~/assets/css/toastr.min.css" rel="stylesheet" />
    <script>
        $(document).ready(function () {
            toastr.info('@TempData["Message"]');
        });
    </script>
}

@if (TempData["ChangePasswordSuccessMessage"] != null)
{
    <script src="//code.jquery.com/jquery-2.2.4.min.js"></script>
    <script src="~/assets/js/toastr.min.js"></script>
     <link href="~/assets/css/toastr.min.css" rel="stylesheet" />
    <script>
        $(document).ready(function () {
            toastr.info('@TempData["ChangePasswordSuccessMessage"]');
        });
    </script>
}

<section class="hold-transition login-page">
    <div class="login-box">
        <div class="login-logo">
            <a href="#"><b>CoursesHub</b></a>
        </div>
        <div class="card">
            <div class="card-body login-card-body">
                <p class="login-box-msg">Change password to secure your account</p>
                @using (Html.BeginForm("ChangePassword", "AdminLogin", FormMethod.Post, new { id = "ChangePassword" }))
                {

                    <div class="input-group mb-3">
                        @Html.PasswordFor(Model => Model.oldPassword, new { @class = "form-control", @placeholder = "Old passowrd", @autocomplete = "off" })
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-eye toggle-oldpassword" toggle="#oldPassword"></span>
                            </div>
                        </div>
                    </div>
                    <div class="input-group mb-3">
                        @Html.PasswordFor(Model => Model.NewPassword, new { @class = "form-control", @placeholder = "New Password", @autocomplete = "off" })
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-eye toggle-password" toggle="#NewPassword"></span>
                            </div>
                        </div>
                    </div>

                    <div class="input-group mb-3">
                        @Html.PasswordFor(Model => Model.RenterNewPassword, new { @type = "password", @class = "form-control", @placeholder = "Re-enter New Password", @autocomplete = "off" })
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-eye toggle-repassword" toggle="#RenterNewPassword"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-block">Change Password</button>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
    <script src="~/Areas/Admin/plugins/jquery/jquery.min.js"></script>
    <script src="~/Areas/Admin/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Areas/Admin/dist/js/adminlte.min.js"></script>
    <script src="~/Areas/Admin/plugins/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/Areas/Admin/plugins/jquery-validation/additional-methods.min.js"></script>
    <script>
        $(function () {
            $('#ChangePassword').validate({
                rules: {
                    oldPassword: {
                        required: true,
                    },
                    NewPassword: {
                        required: true,
                    },
                    RenterNewPassword: {
                        required: true,
                        equalTo: "#NewPassword"
                    },
                },
                messages: {
                    oldPassword: {
                        required: "Enter Old Password",
                    },
                    NewPassword: {
                        required: "Enter New Password",
                    },
                    RenterNewPassword: {
                        required: "Enter Re-enter New Password",
                        equalTo: "New password does not match with re-enter password"
                    },
                },
                errorElement: 'span',
                errorPlacement: function (error, element) {

                    error.addClass('invalid-feedback');
                    element.closest('.input-group').append(error);
                },
                highlight: function (element, errorClass, validClass) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function (element, errorClass, validClass) {
                    $(element).removeClass('is-invalid');
                }
            });
        });

        $(".toggle-password").click(function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $($(this).attr("toggle"));
            if (input.attr("type") == "password") {
                input.attr("type", "text");
            } else {
                input.attr("type", "password");
            }
        });
        $(".toggle-repassword").click(function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $($(this).attr("toggle"));
            if (input.attr("type") == "password") {
                input.attr("type", "text");
            } else {
                input.attr("type", "password");
            }
        });
        $(".toggle-oldpassword").click(function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $($(this).attr("toggle"));
            if (input.attr("type") == "password") {
                input.attr("type", "text");
            } else {
                input.attr("type", "password");
            }
        });
    </script>
</section>
