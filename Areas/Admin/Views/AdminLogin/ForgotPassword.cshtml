@model CoursesHub.Areas.Admin.Models.AdminLogin
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CoursesHub | Forgot Password</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700&display=fallback">
    <link rel="stylesheet" href="~/Areas/Admin/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/Areas/Admin/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="@CoursesHub.AssetVersion.Url("~/Areas/Admin/dist/css/brand-admin.css")">
    <script src="//code.jquery.com/jquery-2.2.4.min.js"></script>
    <script src="~/assets/js/toastr.min.js"></script>
    <link href="~/assets/css/toastr.min.css" rel="stylesheet" />

    <style>
        body.login-page {
            background-color: #f8fafc;
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .login-box {
            width: 400px;
            max-width: calc(100% - 32px);
        }

        @@media (max-width: 767px) {
            .back-to-login {
                display: inline-flex;
                align-items: center;
                min-height: 40px;
            }
        }

        .login-logo a {
            color: #1e293b;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .login-logo span {
            color: var(--primary);
        }
        /* Emerald Dot/Highlight */

        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }

        .login-card-body {
            padding: 1.5rem;
            border-radius: 16px;
        }

        .login-box-msg {
            font-size: 0.95rem;
            color: #64748b;
            padding: 0;
            margin-bottom: 1rem;
            line-height: 1.5;
        }

        .form-control {
            height: 50px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            padding-left: 15px;
        }

            .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
            }

        .input-group-text {
            background: transparent;
            border-left: none;
            color: #94a3b8;
        }

        .btn-emerald {
            background-color: var(--primary);
            border: none;
            color: white;
            height: 50px;
            font-weight: 600;
            border-radius: 8px;            
        }

            .btn-emerald:hover {
                background-color: var(--accent-color);
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.2);
                color: var(--on-accent-color);
            }

        .back-to-login {
            display: inline-flex;
            align-items: center;
            color: #64748b;
            font-weight: 500;
            text-decoration: none;
            transition: color 0.2s;
        }

            .back-to-login:hover {
                color: var(--primary);
            }

        .invalid-feedback {
            font-size: 0.8rem;
            margin-top: 5px;
        }
    </style>
    <style>
        .forgot-animation {
            width: 260px;
            height: 260px;
            margin: 0 auto 15px;
        }

        .login-card-body {
            opacity: 0;
            transform: translateY(20px);
            
        }

            .login-card-body.show-form {
                opacity: 1;
                transform: translateY(0);
            }
    </style>
</head>
<body class="hold-transition login-page">
    @Html.Partial("~/Views/Shared/_PageLoader.cshtml")
    <div class="login-box">
        <div class="login-logo mb-4">
            <a href="#">Courses<span>Hub</span></a>
        </div>
        <div class="card">
            <div class="card-body login-card-body">
                <div class="text-center mb-1">
                    <div id="forgotPasswordAnimation" class="forgot-animation" ></div>
                </div>
                <div class="text-center mb-2">
                    <h5 class="font-weight-bold">Forgot Password?</h5>
                </div>
                <p class="login-box-msg text-left">No worries, enter your email below and we'll send you instructions to reset your password.</p>

                @using (Html.BeginForm("ForgotPassword", "AdminLogin", FormMethod.Post, new { id = "ForgotPassword" }))
                {
                    <div class="form-group mb-4">
                        <label class="small font-weight-bold text-muted">Email Address</label>
                        <div class="input-group">
                            @Html.TextBoxFor(Model => Model.EmailId, new { @type = "email", @class = "form-control", @placeholder = "name@company.com", @autocomplete = "off" })
                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <span class="fas fa-envelope"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-emerald btn-block mb-4">
                        Send Reset Link
                    </button>
                }

                <div class="text-center">
                    <a href="@Url.Action("Login", "AdminLogin")" class="back-to-login">
                        <i class="fas fa-arrow-left mr-2"></i> Back to Login
                    </a>
                </div>
            </div>
        </div>

        <p class="text-center text-muted mt-4 small">
            &copy; @DateTime.Now.Year CoursesHub. All rights reserved.
        </p>
    </div>

    @if (TempData["ForgotErrorMessage"] != null)
    {
        <script>toastr.error('@TempData["ForgotErrorMessage"]');</script>
    }

    <script src="~/Areas/Admin/plugins/jquery/jquery.min.js"></script>
    <script src="~/Areas/Admin/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Areas/Admin/plugins/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/Areas/Admin/dist/js/adminlte.min.js"></script>

    <script>
        $(function () {
            $('#ForgotPassword').validate({
                rules: { EmailId: { required: true, email: true } },
                messages: { EmailId: { required: "Please enter your email", email: "Please enter a valid email address" } },
                errorElement: 'span',
                errorPlacement: function (error, element) {
                    error.addClass('invalid-feedback');
                    element.closest('.form-group').append(error);
                },
                highlight: function (element) { $(element).addClass('is-invalid'); },
                unhighlight: function (element) { $(element).removeClass('is-invalid'); }
            });
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js"></script>

    <script>
$(document).ready(function () {

    const container = document.getElementById("forgotPasswordAnimation");

    if (!container) {
        console.error("Lottie container not found");
        return;
    }

    lottie.loadAnimation({
        container: container,
        renderer: "svg",
        loop: true,
        autoplay: true,
        path: "@Url.Content("~/assets/animations/forgot-password.json")"
    });

    setTimeout(function () {
        $(".login-card-body").addClass("show-form");
    }, 1500);

});
    </script>



</body>
</html>
