@model CoursesHub.Models.User
@{
    ViewBag.Title = "EditLoginDetails";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<script src="//code.jquery.com/jquery-2.2.4.min.js"></script>
<script src="~/assets/js/toastr.min.js"></script>
<link href="~/assets/css/toastr.min.css" rel="stylesheet" />
<link href="@CoursesHub.AssetVersion.Url("~/assets/css/adminCustom.css")" rel="stylesheet" />

@if (TempData["Message"] != null)
{
    <script>
        $(document).ready(function () {
            toastr.info('@TempData["Message"]');
        });
    </script>
}
<section class="content-header">
    <div class="container-fluid py-3">
        <h1 class="h3 font-weight-bold text-dark">User Update</h1>
        <p class="text-muted">Modify administrative credentials and profile settings.</p>
    </div>
</section>

<section class="content">
    
     
            @using (Html.BeginForm("EditLoginDetails", "AdminLogin", FormMethod.Post, new { id = "UserRegistration", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.userId)

                <div class="card-body p-4 p-lg-5  detail-card"  style="border-top: 4px solid var(--primary-color);">
                    <div class="row">
                        <div class="col-lg-4 text-center border-right mb-4 mb-lg-0">
                            <label class="d-block text-uppercase small font-weight-bold text-muted mb-3">Profile Picture</label>
                            <div class="profile-img-container mb-4">
                                <img id="imgPreview"
                                     src="@(string.IsNullOrEmpty(Model.Image) ? "/assets/img/default-avatar.png" : Model.Image)"
                                     class="rounded-circle shadow-sm"
                                     style="width: 150px; height: 150px; object-fit: cover; border: 4px solid #fff;" />
                            </div>

                            <div class="custom-file text-left" style="max-width: 250px; margin: 0 auto;">
                                @Html.TextBoxFor(model => model.ProfileImage, new { type = "file", @class = "custom-file-input", @id = "fileInput", @accept = "image/*" })
                                <label class="custom-file-label text-truncate" for="fileInput">Change Photo</label>
                            </div>

                            @Html.HiddenFor(model => model.Image)

                            <small class="text-muted d-block mt-2">Leave empty to keep current image</small>
                        </div>

                        <div class="col-lg-8 pl-lg-5">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="form-group">
                                        <label>Full Name</label>
                                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @placeholder = "Update Name" })
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-group">
                                        <label>Email Address</label>
                                        @Html.TextBoxFor(model => model.EmailId, new { @class = "form-control", @placeholder = "Update Email" })
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-group">
                                        <label>Mobile Number</label>
                                        @Html.TextBoxFor(model => model.mobileNo, new { @class = "form-control", @maxlength = "10" })
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-group">
                                        <label>Role</label>
                                        @Html.DropDownListFor(model => model.RoleID, (SelectList)ViewBag.Role, "Select Role", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-md-12 mb-4">
                                    <div class="form-group">
                                        <label>Password</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.Password, new { @class = "form-control", @id = "Password", @type = "password" })
                                            <div class="input-group-append">
                                                <span class="input-group-text bg-white border-left-0" style="cursor: pointer;">
                                                    <i class="fas fa-eye toggle-password" toggle="#Password"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-4 border-top text-right">
                                <button type="submit" class="btn btn-update">Save Changes</button>
                            </div>
                        </div>
                    </div>
                </div>}
        
    
</section>

<script src="~/Areas/Admin/plugins/jquery/jquery.min.js"></script>
<script src="~/Areas/Admin/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/Areas/Admin/plugins/bs-custom-file-input/bs-custom-file-input.min.js"></script>
<script>
    $(function () {
        bsCustomFileInput.init();

        // Real-time Image Preview
        $(function () {
            $("#fileInput").on("change", function () {
                const file = this.files[0];
                if (file) {
                    let reader = new FileReader();
                    reader.onload = function (e) {
                        $("#imgPreview").attr("src", e.target.result); // Replaces existing pic with new preview
                    };
                    reader.readAsDataURL(file);
                }
            });
        });

        // Toggle Password Visibility
        $(".toggle-password").click(function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $($(this).attr("toggle"));
            input.attr("type", input.attr("type") === "password" ? "text" : "password");
        });

        // Validation
        $('#UserRegistration').validate({
            rules: {
                Name: { required: true },
                EmailId: { required: true, email: true },
                mobileNo: { required: true, digits: true, rangelength: [10, 10] },
                Password: { required: true }
            },
            errorElement: 'span',
            errorPlacement: function (error, element) {
                error.addClass('invalid-feedback');
                element.closest('.form-group').append(error);
            },
            highlight: function (element) { $(element).addClass('is-invalid'); },
            unhighlight: function (element) { $(element).removeClass('is-invalid'); }
        });
    });
</script>
