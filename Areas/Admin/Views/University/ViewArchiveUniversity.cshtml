@model  List<CoursesHub.Models.UniversityRegistration>

@{
    ViewBag.Title = "ViewArchiveUniversity";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Areas/Admin/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/Areas/Admin/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="~/Areas/Admin/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
<script src="//code.jquery.com/jquery-2.2.4.min.js"></script>
<script src="~/assets/js/toastr.min.js"></script>
<link href="~/assets/css/toastr.min.css" rel="stylesheet" />
<link href="@CoursesHub.AssetVersion.Url("~/assets/css/adminCustom.css")" rel="stylesheet" />
@if (TempData["EditUniversityDetailsMsg"] != null)
{
    <script>
        $(document).ready(function () {
            toastr.info('@TempData["EditUniversityDetailsMsg"]');
        });
    </script>
}

@* Loading uses the shared Courses Hub loader (CHLoader, Views/Shared/_PageLoader.cshtml) *@

<section class="content-header pt-4 px-4">
    <div class="container-fluid">
        <div class="row mb-3 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 font-weight-bold text-dark" style="letter-spacing: -1px;">Training Providers</h1>
                <p class="text-muted mb-0">Get Archived training organizations.</p>
            </div>
        </div>
    </div>
</section>

<section class="content px-4 pb-4">
    <div class="container-fluid">
        <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table id="example1" class="table table-hover mb-0" style="width:100%">
                        <thead>
                            <tr>
                                <th class="border-0 px-4 py-3">Provider Details</th>
                                <th class="border-0 py-3">RTO ID</th>
                                <th class="border-0 py-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle mr-3">
                                                @item.Legal_Name_Organisation.Substring(0, 1)
                                            </div>
                                            <div>
                                                <div class="font-weight-bold text-dark">@item.Legal_Name_Organisation</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 text-secondary font-weight-bold">
                                        @item.RTO_ID
                                    </td>
                                    <td class="py-3 text-center">
                                        <div class="d-flex justify-content-center">
                                            <a href="@Url.Action("ArchiveUniversityDetails","University",new {UniversityID=item.Id})"
                                               class="btn-action mr-2" title="View">
                                                <i class="fa fa-eye text-primary"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $(document).ready(function () {
        if (window.CHLoader) { CHLoader.show('Loading…'); }

        var table = $("#example1").DataTable({
            "destroy": true,
            "responsive": true,
            "lengthChange": false,
            "autoWidth": false
            //"buttons": [
            //    {
            //        extend: 'copy',
            //        className: 'btn btn-sm btn-dark rounded-pill px-3 mr-1 shadow-sm',
            //        exportOptions: { columns: ":visible" }
            //    },
            //    {
            //        extend: 'csv',
            //        className: 'btn btn-sm btn-dark rounded-pill px-3 mr-1 shadow-sm',
            //        exportOptions: { columns: ":visible" }
            //    },
            //    {
            //        extend: 'excel',
            //        className: 'btn btn-sm btn-dark rounded-pill px-3 mr-1 shadow-sm',
            //        exportOptions: { columns: ":visible" }
            //    },
            //    {
            //        extend: 'pdf',
            //        className: 'btn btn-sm btn-dark rounded-pill px-3 mr-1 shadow-sm',
            //        exportOptions: { columns: ":visible" }
            //    },
            //    {
            //        extend: 'print',
            //        className: 'btn btn-sm btn-dark rounded-pill px-3 mr-1 shadow-sm',
            //        exportOptions: { columns: ":visible" }
            //    },
            //]
        });

        // This ensures the buttons are placed in the top-left area of the table grid
        table.buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');

        if (window.CHLoader) { CHLoader.hide(); }
    });
</script>
<script>
    $(document).on('click', '.delete-course', function (e) {
        e.preventDefault();
        var url = $(this).data('url');

        Swal.fire({
            title: "Are you sure?",
            text: "This will permanently delete the record!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#158887",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = url;
            }
        });
    });
</script>

