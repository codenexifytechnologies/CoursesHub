@model List<CoursesHub.Areas.Admin.Models.Lead>
@{
    ViewBag.Title = "ViewLead";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Areas/Admin/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/Areas/Admin/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="~/Areas/Admin/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
<link href="@CoursesHub.AssetVersion.Url("~/assets/css/adminCustom.css")" rel="stylesheet" />


@* Loading uses the shared Courses Hub loader (CHLoader, Views/Shared/_PageLoader.cshtml) *@


<section class="content-header pt-4 px-4">
    <div class="container-fluid">
        <div class="row mb-3 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 font-weight-bold text-dark" style="letter-spacing: -1px;">Leads Management</h1>
                <p class="text-muted mb-0">Track and manage student inquiries and course leads.</p>
            </div>
           
        </div>
    </div>
</section>

<section class="content px-4 pb-4">
    <div class="container-fluid">
        <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table id="example1" class="table table-hover mb-0" style="width:100%">
                        <thead>
                            <tr>
                                <th class="border-0 px-4 py-3">Student Details</th>
                                <th class="border-0 py-3">Contact</th>
                                <th class="border-0 py-3">Course & Category</th>
                                <th class="border-0 py-3 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="px-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle mr-3">
                                                    @item.Student_Name.Substring(0, 1)
                                                </div>
                                                <div>
                                                    <div class="font-weight-bold text-dark">@item.Student_Name</div>
                                                    <small class="text-muted">@item.Student_EmailId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3 text-secondary small">
                                            <i class="fas fa-phone-alt mr-2 text-muted"></i>@item.Student_Mobile
                                        </td>
                                        <td class="py-3">
                                            <div class="font-weight-600 text-dark" style="font-size: 0.9rem;">@item.Course_Name</div>
                                            <span class="badge badge-soft-primary mt-1">@item.CourseCategory</span>
                                        </td>
                                        <td class="py-3 text-center">
                                            <a href="@Url.Action("ViewLeadDetails", "Lead", new { Student_ID = item.Student_ID })"
                                               class="btn-action mx-auto" title="View Details">
                                                <i class="fa fa-eye text-primary"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>


<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        if (window.CHLoader) { CHLoader.show('Loading…'); }
        var table = $("#example1").DataTable({
            "destroy": true,
            "responsive": true,
            "lengthChange": false,
            "autoWidth": false
            //"buttons": [
            //    {
            //        extend: 'copy', className: 'btn btn-dark',
            //        exportOptions: { columns: ":visible" }
            //    },
            //    {
            //        extend: 'csv', className: 'btn btn-dark',
            //        exportOptions: { columns: ":visible" }
            //    },
            //    {
            //        extend: 'excel', className: 'btn btn-dark',
            //        exportOptions: { columns: ":visible" }
            //    },
            //    {
            //        extend: 'pdf', className: 'btn btn-dark',
            //        exportOptions: { columns: ":visible" }
            //    },
            //    {
            //        extend: 'print', className: 'btn btn-dark',
            //        exportOptions: { columns: ":visible" }
            //    },
            //]
        });

        // Appends buttons to the correct wrapper area
        table.buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
        if (window.CHLoader) { CHLoader.hide(); }
    });
</script>