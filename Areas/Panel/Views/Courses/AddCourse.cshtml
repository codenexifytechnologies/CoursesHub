                                                @Html.TextBoxFor(m => m.CourseVideo2, new { @placeholder = "Add Your Course URL here 2" })
                                                <small class="d-block mt_dec--5">Example: <a>https://www.youtube.com/watch?v=yourvideoid</a></small>
                                            </div>

                                            <div class="course-field mb--15">
                                                <label for="videoUrl">Add Your Course Video URL 3</label>
