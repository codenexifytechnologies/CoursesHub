                                <span class="icon-reverse-wrapper">
                                    <span class="btn-text">Save</span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                </span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</div>
</div>
@section scripts
    {
    <script src="~/assets/js/vendor/jquery.js"></script>
    <script src="~/Plugins/jquery-validation/jquery.validate.min.js"></script>
    @*<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>*@
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script>
        function toggleSlider() {
            document.getElementById('slider').classList.toggle('open');
        }
        document.querySelectorAll('.accordion-collapse').forEach(function (el) {
            el.addEventListener('shown.bs.collapse', function (event) {
                const header = event.target.previousElementSibling; // header of opened accordion
                const headerPosition = header.getBoundingClientRect().top + window.pageYOffset - 100; // 100px offset from top
                window.scrollTo({ top: headerPosition, behavior: 'smooth' });
            });
        });
        $(document).ready(function () {
            $("input[name='StudyMethod']").on("change", function () {
                $("#studyMethodContainer").removeClass("border border-danger rounded p-2");
                $("#studyMethodContainer").find("span.text-danger").remove();
                $("#AddCourse").validate().element(this);
            });
            $("#CourseCategory").on("change", function () {
                $("#courseCategoryContainer").removeClass("border border-danger rounded p-2");
                $("#courseCategoryContainer").find("span.text-danger").remove();
                $("#AddCourse").validate().element(this);
            });

            $("#addRow").click(function () {
                var index = $("#testimonialTable tbody tr").length;
                var newRow = `
                                                    <tr>
                                                    <td><input class='form-control' name='Testimonials[` + index + `].Person_Name' /></td>
                                                    <td><input class='form-control' name='Testimonials[` + index + `].Designation' /></td>
                                                    <td><textarea class='form-control' rows='2' name='Testimonials[` + index + `].Comment'></textarea></td>
                                                    <td><button type='button' class='btn btn-danger remove-row'>X</button></td>
                                                    </tr>`;
                $("#testimonialTable tbody").append(newRow);
            });

            $(document).on("click", ".remove-row", function () {
                $(this).closest("tr").remove();
            });

            $('#CourseStartDate').datepicker({
                dateFormat: "dd/mm/yy",
                changeMonth: true,
                changeYear: true,
                minDate: 0,
                onSelect: function () {
                    // Remove validation error once date selected
                    $(this).valid();
                }
            });

            $("#CourseStartDate").on("change", function () {
                $(this).valid();
            });
        });
    </script>


    <script>

        var editors = {};   // store all editor instances

        function initEditors() {

            const editorIds = [
                { editor: '#editor_AboutCourse', hidden: '#AboutCourse' },
                { editor: '#editor_CourseOverview', hidden: '#CourseOverview' },
                { editor: '#editor_CourseOutcomes', hidden: '#CourseOutcomes' },
                //{ editor: '#editor_CourseLearn', hidden: '#CourseLearn' },
                { editor: '#editor_CourseRequirements', hidden: '#CourseRequirements' },
                { editor: '#editor_WorkPlacement', hidden: '#WorkPlacement' },
                { editor: '#editor_RPL', hidden: '#RPL' }
                // add more if needed
            ];

            editorIds.forEach(item => {
                ClassicEditor
                    .create(document.querySelector(item.editor), {
                        removePlugins: [
                            'Image',
                            'ImageToolbar',
                            'ImageCaption',
                            'ImageStyle',
                            'ImageUpload',
                            'MediaEmbed',
                            'CKFinderUploadAdapter',
                            'CKFinder',
                            'EasyImage'
                        ]
                    })
                    .then(editor => {
                        const editable = editor.ui.view.editable.element;
                        editable.style.height = "200px";
                        editable.style.maxHeight = "200px";
                        editable.style.overflowY = "auto";

                        editors[item.editor] = {
                            instance: editor,
                            hiddenInput: item.hidden
                        };

                        // Set data from hidden field
                        if ($(item.hidden).val()) {
                            editor.setData($(item.hidden).val());
                        }
                    })
                    .catch(error => console.error(error));
            });
        }

        initEditors();


        function setHtmlBeforeSubmit() {
            var isValid = true;

            Object.keys(editors).forEach(key => {
                var editorObj = editors[key];
                var data = editorObj.instance.getData();
                $(editorObj.hiddenInput).val(data);
            });

            return isValid;
        }

    </script>

    <script>
        $(document).ready(function () {
            $("#AddCourse").validate({
                ignore: [], // IMPORTANT for CKEditor hidden fields

                rules: {
                    CourseName: {
                        required: true
                    },
                    CourseProvider: {
                        required: true
                    },
                    AboutCourse: {
                        required: true
                    },
                    StudyMethod: {
                        required: true
                    },
                    GovernmentFunding: {
                        required: true
                    },
                    StudentType: {
                        required: true
                    },
                    CourseCategory: {
                        required: true
                    },
                    CourseStartDate: {
                        required: true
                    },
                    CourseDuration: {
                        required: true,
                        digits: true
                    },
                    CourseOverview: {
                        required: true
                    }
                },

                invalidHandler: function (event, validator) {

                    if (validator.errorList.length) {

                        var firstError = $(validator.errorList[0].element);

                        // find the accordion section
                        var accordionBody = firstError.closest(".accordion-collapse");

                        if (accordionBody.length && !accordionBody.hasClass("show")) {

                            // open accordion
                            var collapse = new bootstrap.Collapse(accordionBody[0], {
                                toggle: true
                            });

                            // wait for animation then focus
                            accordionBody.on('shown.bs.collapse', function () {
                                $('html, body').animate({
                                    scrollTop: firstError.offset().top - 120
                                }, 500);

                                firstError.focus();
                            });

                        } else {

                            $('html, body').animate({
                                scrollTop: firstError.offset().top - 120
                            }, 500);

                            firstError.focus();
                        }
                    }
                },

                messages: {
                    CourseName: "Please enter course name",
                    CourseProvider: "Please enter course provider",
                    AboutCourse: "Please enter about course",
                    StudyMethod: "Please select study method",
                    GovernmentFunding: "Please select government funding",
                    StudentType: "Please select student type",
                    CourseCategory: "Please select course category",
                    CourseStartDate: "Please select start date",
                    CourseDuration: {
                        required: "Please enter course duration",
                        digits: "Only numbers allowed."
                    },
                    CourseOverview: "Please enter course overview"
                },

                errorElement: 'span',
                errorClass: 'text-danger',
                highlight: function (element) {
                    if (element.name === "StudyMethod") {
                        $("#studyMethodContainer")
                            .addClass("border border-danger rounded p-2");
                    }
                    else if (element.name === "GovernmentFunding") {
                        $("#governmentFundingContainer")
                            .addClass("border border-danger rounded p-2");
                    }
                    else if (element.name === "StudentType") {
                        $("#studentTypeContainer")
                            .addClass("border border-danger rounded p-2");
                    }
                    else {
                        $(element).addClass('is-invalid');
                        $(".focus-border").removeClass('focus-border');
                    }
                },
                unhighlight: function (element) {
                    if (element.name === "StudyMethod") {
                        $("#studyMethodContainer")
                            .removeClass("border border-danger rounded p-2");
                    }
                    else if (element.name === "GovernmentFunding") {
                        $("#governmentFundingContainer")
                            .removeClass("border border-danger rounded p-2");
                    }
                    else if (element.name === "StudentType") {
                        $("#studentTypeContainer")
                            .removeClass("border border-danger rounded p-2");
                    }
                    else {
                        $(element).removeClass('is-invalid');
                        $(".focus-border").removeClass('focus-border');
                    }
                },


                errorPlacement: function (error, element) {
                    // Radio buttons (Study Method)
                    if (element[0].name === "StudyMethod") {
                        error.insertAfter("#studyMethodContainer");
                        return;
                    }
                    if (element[0].name === "GovernmentFunding") {
                        error.insertAfter("#governmentFundingContainer");
                        return;
                    }
                    if (element[0].name === "StudentType") {
                        error.insertAfter("#studentTypeContainer");
                        return;
                    }
                    if (element[0].name === "CourseCategory") {
                        error.insertAfter("#courseCategoryContainer");
                        return;
                    }
                        // CKEditor fields
                    else if (element.attr("name") === "AboutCourse" ||
                        element.attr("name") === "CourseOverview") {
                        error.insertAfter(element.closest(".course-field").find(".ckeditor-wrapper"));
                    }
                    else {
                        error.insertAfter(element);
                    }
                }
            });


            $('#CourseCategory').on('changed.bs.select', function () {
                var selected = $(this).selectpicker('val');
                //$('#hiddenZipcode').val(selected);
                $("#CourseCategory-error").remove();
            });

        });


    </script>

}