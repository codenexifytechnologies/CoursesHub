@model CoursesHub.Models.ChangePassword
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Areas/Student/Views/Shared/_Layout.cshtml";
}

@if (TempData["ChangePasswordSuccessMessage"] != null)
{
    <script src="//code.jquery.com/jquery-2.2.4.min.js"></script>
    <script src="~/assets/js/toastr.min.js"></script>
     <link href="~/assets/css/toastr.min.css" rel="stylesheet" />
    <script>
     $(document).ready(function () {
         toastr.error('@TempData["ChangePasswordSuccessMessage"]');
     });
    </script>
}
<style>
    .password-wrapper {
        position: relative;
    }

        .password-wrapper .toggle-npassword {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #666;
            z-index: 5;
        }

        .password-wrapper .toggle-rpassword {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #666;
            z-index: 5;
        }
</style>
<div class="sd-page">
    <div class="sd-card sd-reveal">
        <div class="sd-page-head">
            <span class="sd-page-icon"><i class="feather-lock"></i></span>
            <div>
                <h4 class="sd-page-title">Change Password</h4>
                <p class="sd-page-sub">Choose a strong new password to keep your account safe.</p>
            </div>
        </div>
        <div class="sd-split">
            <div class="sd-split-form">
                @using (Html.BeginForm("ChangePassword", "Student", FormMethod.Post, new { id = "ChangePassword", @class = "sd-form" }))
                {
                    @Html.HiddenFor(Model => Model.Id)
                    @Html.HiddenFor(Model => Model.oldPassword)
                    <div class="sd-field">
                        <label for="NewPassword">New Password</label>
                        <div class="rbt-profile-content b2 password-wrapper">
                            <i class="feather-lock sd-field-icon" aria-hidden="true"></i>
                            @Html.PasswordFor(Model => Model.NewPassword, new { @class = "form-control", @placeholder = "New passowrd", @autocomplete = "off" })
                            <span class="fas fa-eye toggle-npassword" toggle="#NewPassword" role="button" aria-label="Show or hide password"></span>
                        </div>
                    </div>
                    <div class="sd-field">
                        <label for="RenterNewPassword">Re-enter New Password</label>
                        <div class="rbt-profile-content b2 password-wrapper">
                            <i class="feather-check-square sd-field-icon" aria-hidden="true"></i>
                            @Html.PasswordFor(Model => Model.RenterNewPassword, new { @class = "form-control", @placeholder = "Re-enter New passowrd", @autocomplete = "off" })
                            <span class="fas fa-eye toggle-rpassword" toggle="#RenterNewPassword" role="button" aria-label="Show or hide password"></span>
                        </div>
                    </div>
                    <div class="form-submit-group sd-form-actions">
                        <button type="submit" value="Save" name="submitButton" class="sd-btn" onclick="return setHtmlBeforeSubmit();">
                            <i class="feather-shield"></i> Change Password
                        </button>
                    </div>
                }
            </div>
            <div class="sd-split-side">
                <img src="@CoursesHub.AssetVersion.Url("~/assets/images/student/student-security.svg")" alt="" aria-hidden="true">
                <ul class="sd-tips">
                    <li><i class="feather-check"></i> Use at least 8 characters</li>
                    <li><i class="feather-check"></i> Mix upper and lower case letters</li>
                    <li><i class="feather-check"></i> Add numbers and symbols</li>
                    <li><i class="feather-check"></i> Don't reuse an old password</li>
                </ul>
            </div>
        </div>
    </div>
</div>
@section scripts
    {
    <script src="~/assets/js/vendor/jquery.js"></script>
    <script src="~/Plugins/jquery-validation/jquery.validate.min.js"></script>
    <script>
        $(function () {
            $('#ChangePassword').validate({
                rules: {
                    NewPassword: {
                        required: true,
                    },
                    RenterNewPassword: {
                        required: true,
                    },
                },
                messages: {
                    NewPassword: {
                        required: "Enter New Password",
                    },
                    RenterNewPassword: {
                        required: "Enter Re-enter New Password",
                    },
                },
                errorElement: 'span',
                errorPlacement: function (error, element) {

                    error.addClass('invalid-feedback');
                    element.closest('.sd-field').append(error);
                },
                highlight: function (element, errorClass, validClass) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function (element, errorClass, validClass) {
                    $(element).removeClass('is-invalid');
                }
            });
        });

        $(".toggle-npassword").click(function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $($(this).attr("toggle"));
            if (input.attr("type") == "password") {
                input.attr("type", "text");
            } else {
                input.attr("type", "password");
            }
        });
        $(".toggle-rpassword").click(function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $($(this).attr("toggle"));
            if (input.attr("type") == "password") {
                input.attr("type", "text");
            } else {
                input.attr("type", "password");
            }
        });

    </script>
}

